// Устойчивое состояние расчёта хранит сервер. Ссылки документов оплаты
// детерминированы checkout_id. Повторный вызов оборудования не автоматизируется.

&НаСервере
Функция ПодготовитьРасчет(ДанныеДействия, Данные)
    СохранитьЗаказИОтправить(ДанныеДействия.tab, ДанныеДействия.point);
    Заказ = ДанныеДействия.tab.order;
    СсылкаДокумента = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Заказ.order_ref));
    Если СсылкаДокумента.ВалютаДокумента <> УправлениеНебольшойФирмойПовтИсп.ПолучитьНациональнуюВалюту() Тогда ВызватьИсключение "Рабочее место принимает оплату в национальной валюте. Проверьте валюту заказа."; КонецЕсли;
    Баллы = ЧислоИзJSON(ДанныеДействия.points);
    Наличные = ЧислоИзJSON(ДанныеДействия.cash);
    Карта = ЧислоИзJSON(ДанныеДействия.card);
    Если Баллы + Наличные + Карта <> ЧислоИзJSON(Заказ.total) Тогда
        Данные.Вставить("opened", ОткрытьЗапись(ДанныеДействия.id));
        ВызватьИсключение "Итог после расчёта 1С изменился. Проверьте обновлённую сумму перед оплатой.";
    КонецЕсли;
    Настройки = Настройка("Точка_" + ПроверитьUUID(ДанныеДействия.point), Новый Структура);
    ПараметрыККТ = УправлениеНебольшойФирмойПовтИсп.ПолучитьПараметрыКассыККМ(СсылкаНастройки(Настройки, "fiscal"));
    Если Не ЗначениеЗаполнено(ПараметрыККТ.ИдентификаторУстройства) Или ПараметрыККТ.ИспользоватьБезПодключенияОборудования Тогда ВызватьИсключение "В настройках точки выберите подключённую ККТ."; КонецЕсли;
    Если Карта > 0 Тогда
        ПараметрыЭТ = УправлениеНебольшойФирмойПовтИсп.ПолучитьПараметрыЭТ(СсылкаНастройки(Настройки, "terminal"));
        Если Не ЗначениеЗаполнено(ПараметрыЭТ.ИдентификаторУстройства) Или ПараметрыЭТ.ИспользоватьБезПодключенияОборудования Тогда ВызватьИсключение "Выберите подключённый эквайринговый терминал."; КонецЕсли;
        СсылкаНастройки(Настройки, "cardtype");
    КонецЕсли;
    Если Наличные > 0 Тогда СсылкаНастройки(Настройки, "cashbox"); КонецЕсли;
    ИдРасчета = Строка(Новый УникальныйИдентификатор);
    Тело = Новый Структура("revision,checkout_id,points,cash,card", Заказ.revision, ИдРасчета, Баллы, Наличные, Карта);
    Ответ = API(ПутьРабочегоМеста(ДанныеДействия.id) + "prepare/", Тело);
    Заказ = Ответ.order;
    Контекст = Новый Структура("id,checkout_id,point,order", ПроверитьUUID(ДанныеДействия.id), ИдРасчета, ПроверитьUUID(ДанныеДействия.point), Заказ);
    ЭтотОбъект["КонтекстРасчета"] = ВJSON(Контекст);
    ПрименитьБаллыИДокументы(Контекст);
    Данные.Вставить("opened", ОткрытьЗапись(ДанныеДействия.id));
    Возврат ДействиеРасчета(Контекст);
КонецФункции

&НаСервере
Процедура ОтменитьПодготовленныйРасчет(Ид)
    Таб = ОткрытьЗапись(Ид);
    Если Таб.order = Неопределено Или Таб.order.state <> "prepared" Тогда ВызватьИсключение "Расчёт уже запускался на оборудовании. Автоматическая отмена запрещена."; КонецЕсли;
    Контекст = Новый Структура("id,checkout_id,point,order", Ид, Таб.order.checkout_id, Таб.booking.service_point, Таб.order);
    НачатьТранзакцию();
    Попытка
        Для Каждого Имя Из СтрРазделить("ОперацияПоПлатежнымКартам,ПоступлениеВКассу", ",") Цикл
            Платеж = ПлатежПоРасчету(Имя, Контекст.checkout_id);
            Если Платеж = Неопределено Тогда Продолжить; КонецЕсли;
            Если Платеж.Проведен Или Платеж.НомерЧекаККМ > 0 Тогда ВызватьИсключение "Документ оплаты уже проведён или фискализирован. Нужна сверка."; КонецЕсли;
            Если Имя = "ОперацияПоПлатежнымКартам" И Не ПустаяСтрока(Платеж.СсылочныйНомер) Тогда ВызватьИсключение "Есть банковское подтверждение. Отмена без возврата запрещена."; КонецЕсли;
            Платеж.УстановитьПометкуУдаления(Истина);
        КонецЦикла;
        Документ = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Таб.order.order_ref)).ПолучитьОбъект();
        Если Документ.Проведен Или Документ.НомерЧекаККМ > 0 Тогда ВызватьИсключение "Заказ уже проведён или имеет чек."; КонецЕсли;
        Для Каждого СтрокаДок Из Документ.Работы Цикл СтрокаДок.СуммаСкидкиОплатыБонусом = 0; КонецЦикла;
        Для Каждого СтрокаДок Из Документ.Запасы Цикл СтрокаДок.СуммаСкидкиОплатыБонусом = 0; КонецЦикла;
        ПересчитатьДокумент(Документ);
        Документ.Записать(РежимЗаписиДокумента.Запись);
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    СобытиеРасчета(Контекст, "cancel");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПутьРабочегоМеста(Ид)
    Возврат "/api/v1/onec/workplace/bookings/" + ПроверитьUUID(Ид) + "/";
КонецФункции

&НаСервере
Функция СобытиеРасчета(Контекст, Событие, Дополнения = Неопределено)
    Тело = Новый Структура("checkout_id,event", Контекст.checkout_id, Событие);
    Если Дополнения <> Неопределено Тогда
        Для Каждого Пара Из Дополнения Цикл Тело.Вставить(Пара.Ключ, Пара.Значение); КонецЦикла;
    КонецЕсли;
    Ответ = API(ПутьРабочегоМеста(Контекст.id) + "event/", Тело);
    Контекст.order = Ответ.order;
    ЭтотОбъект["КонтекстРасчета"] = ВJSON(Контекст);
    Возврат Ответ.order;
КонецФункции

&НаСервере
Функция ПродолжитьРасчет(Ид, Данные)
    Таб = ОткрытьЗапись(Ид);
    Если Таб.order = Неопределено Или Таб.order.checkout_id = Неопределено Тогда ВызватьИсключение "Подготовленный расчёт не найден."; КонецЕсли;
    Контекст = Новый Структура("id,checkout_id,point,order", ПроверитьUUID(Ид), Таб.order.checkout_id, ПроверитьUUID(Таб.booking.service_point), Таб.order);
    ЭтотОбъект["КонтекстРасчета"] = ВJSON(Контекст);
    Если Таб.order.state = "acquiring" Тогда
        Платеж = ПлатежПоРасчету("ОперацияПоПлатежнымКартам", Контекст.checkout_id);
        Если Платеж <> Неопределено И Не ПустаяСтрока(Платеж.СсылочныйНомер) Тогда
            СобытиеРасчета(Контекст, "card_succeeded", Новый Структура("bank_reference", Платеж.СсылочныйНомер));
        Иначе ВызватьИсключение "Ожидается сверка результата терминала. Повторное списание заблокировано."; КонецЕсли;
    КонецЕсли;
    Если Контекст.order.state = "fiscalizing" Тогда
        Документ = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Контекст.order.order_ref)).ПолучитьОбъект();
        Если Документ.НомерЧекаККМ > 0 Тогда
            Чек = Новый Структура("number,shift", Формат(Документ.НомерЧекаККМ, "ЧГ=0"), Формат(Документ.НомерСменыККМ, "ЧГ=0"));
            СобытиеРасчета(Контекст, "fiscal_succeeded", Новый Структура("receipt", Чек));
        Иначе ВызватьИсключение "Ожидается сверка чека ККТ. Повторная фискализация заблокирована."; КонецЕсли;
    КонецЕсли;
    Данные.Вставить("opened", ОткрытьЗапись(Ид));
    Если Контекст.order.state = "completed" Тогда Возврат Неопределено; КонецЕсли;
    Возврат ДействиеРасчета(Контекст);
КонецФункции

&НаСервере
Функция ДействиеРасчета(Контекст)
    Настройки = Настройка("Точка_" + Контекст.point, Новый Структура);
    Если Контекст.order.state = "prepared" И ЧислоИзJSON(Контекст.order.card) > 0 Тогда
        ПрименитьБаллыИДокументы(Контекст);
        // Проверяем состав чека, организацию и ККТ до списания денег банком.
        ПараметрыЧекаНаСервере(Контекст);
        ПараметрыЭТ = УправлениеНебольшойФирмойПовтИсп.ПолучитьПараметрыЭТ(СсылкаНастройки(Настройки, "terminal"));
        ПараметрыККТ = УправлениеНебольшойФирмойПовтИсп.ПолучитьПараметрыКассыККМ(СсылкаНастройки(Настройки, "fiscal"));
        Возврат Новый Структура("Действие,Контекст,ПараметрыЭТ,ПараметрыККТ,Сумма", "Банк", Контекст, ПараметрыЭТ, ПараметрыККТ, ЧислоИзJSON(Контекст.order.card));
    КонецЕсли;
    Если Контекст.order.state = "prepared" Тогда
        ПрименитьБаллыИДокументы(Контекст);
        СобытиеРасчета(Контекст, "cash_confirmed");
    КонецЕсли;
    Если Контекст.order.state = "acquired" Тогда
        ПровестиПлатежиРасчета(Контекст);
        Возврат Новый Структура("Действие,Контекст", "Чек", Контекст);
    КонецЕсли;
    ВызватьИсключение "Этот этап расчёта требует сверки. Повторная оплата не запускается.";
КонецФункции

&НаСервере
Процедура ПрименитьБаллыИДокументы(Контекст)
    Настройки = Настройка("Точка_" + Контекст.point, Новый Структура);
    НачатьТранзакцию();
    Попытка
        Ссылка = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Контекст.order.order_ref));
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("Документ.асЗаказНаряд").УстановитьЗначение("Ссылка", Ссылка);
        Блокировка.Заблокировать();
        Документ = Ссылка.ПолучитьОбъект();
        Если Документ.Проведен Или Документ.НомерЧекаККМ > 0 Тогда ВызватьИсключение "Заказ проведён или чек уже зарегистрирован."; КонецЕсли;
        // Скидку распределяем от неизменяемого снимка, а не от уже уменьшенной суммы.
        ОсталосьБаллов = ЧислоИзJSON(Контекст.order.points);
        ОбщаяСумма = ЧислоИзJSON(Контекст.order.total);
        Индекс = 0;
        Для Каждого Исходная Из Контекст.order.lines Цикл
            ИмяТЧ = ?(Исходная.kind = "work", "Работы", "Запасы");
            ИмяИд = ?(Исходная.kind = "work", "ИдентификаторРаботы", "ИдентификаторСтроки");
            СтрокаДок = Документ[ИмяТЧ].Найти(ИдентификаторСтрокиЗаказа(Исходная.line_id, ИмяТЧ), ИмяИд);
            Если СтрокаДок = Неопределено Тогда ВызватьИсключение "Состав заказа изменился после подготовки расчёта."; КонецЕсли;
            Индекс = Индекс + 1;
            СуммаСтроки = ЧислоИзJSON(Исходная.amount);
            Доля = ?(Индекс = Контекст.order.lines.Количество(), ОсталосьБаллов, Окр(ЧислоИзJSON(Контекст.order.points) * СуммаСтроки / ОбщаяСумма, 2));
            ОсталосьБаллов = ОсталосьБаллов - Доля;
            // В документе сумма скидки хранится в той же базе НДС, что цена.
            Если Не Документ.СуммаВключаетНДС Тогда Доля = Окр(Доля / (1 + СтрокаДок.СтавкаНДС.Ставка / 100), 2); КонецЕсли;
            СтрокаДок.СуммаСкидкиОплатыБонусом = Доля;
        КонецЦикла;
        ПересчитатьДокумент(Документ);
        Если Документ.СуммаДокумента <> ЧислоИзJSON(Контекст.order.cash) + ЧислоИзJSON(Контекст.order.card) Тогда
            ВызватьИсключение "Распределение скидки с НДС не сошлось до копейки. Оплата не запущена; проверьте расчёт.";
        КонецЕсли;
        Документ.Состояние = Справочники.асСостоянияЗаказНарядов.Выполнен;
        Документ.ДатаОкончания = ТекущаяДатаСеанса();
        Документ.Записать(РежимЗаписиДокумента.Запись);
        Если ЧислоИзJSON(Контекст.order.card) > 0 Тогда
            ПодготовитьПлатеж("ОперацияПоПлатежнымКартам", Контекст, Документ, Настройки, ЧислоИзJSON(Контекст.order.card));
        КонецЕсли;
        Если ЧислоИзJSON(Контекст.order.cash) > 0 Тогда
            ПодготовитьПлатеж("ПоступлениеВКассу", Контекст, Документ, Настройки, ЧислоИзJSON(Контекст.order.cash));
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    ЗначениеВРеквизитФормы(Документ, "Объект");
КонецПроцедуры

&НаСервере
Функция ПлатежПоРасчету(Имя, Ид)
    Ссылка = Документы[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
    Возврат ?(ЕстьОбъект("Документ." + Имя, Ссылка), Ссылка.ПолучитьОбъект(), Неопределено);
КонецФункции

&НаСервере
Процедура ПодготовитьПлатеж(Имя, Контекст, Документ, Настройки, Сумма)
    Платеж = ПлатежПоРасчету(Имя, Контекст.checkout_id);
    Если Платеж <> Неопределено Тогда
        Если Платеж.СуммаДокумента <> Сумма Тогда ВызватьИсключение "Сумма документа оплаты изменена. Нужна сверка."; КонецЕсли;
        Если Платеж.ПометкаУдаления И Не Платеж.Проведен Тогда Платеж.УстановитьПометкуУдаления(Ложь); КонецЕсли;
        Возврат;
    КонецЕсли;
    Платеж = Документы[Имя].СоздатьДокумент();
    Платеж.Дата = ТекущаяДатаСеанса();
    Платеж.Заполнить(Документ.Ссылка);
    Платеж.УстановитьСсылкуНового(Документы[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Контекст.checkout_id)));
    Если Имя = "ОперацияПоПлатежнымКартам" Тогда
        Платеж.ЭквайринговыйТерминал = СсылкаНастройки(Настройки, "terminal");
        Платеж.ВидПлатежнойКарты = СсылкаНастройки(Настройки, "cardtype");
        ЗаполнитьЭквайрингПлатежа(Платеж);
    Иначе Платеж.Касса = СсылкаНастройки(Настройки, "cashbox"); КонецЕсли;
    Платеж.КассаККМ = СсылкаНастройки(Настройки, "fiscal");
    Платеж.ВалютаДенежныхСредств = Документ.ВалютаДокумента;
    Платеж.Курс = 1;
    Платеж.Кратность = 1;
    ИсходнаяСумма = Платеж.РасшифровкаПлатежа.Итог("СуммаПлатежа");
    Если ИсходнаяСумма <= 0 Тогда ВызватьИсключение "Штатное заполнение оплаты не сформировало расшифровку. Проверьте договор клиента."; КонецЕсли;
    Осталось = Сумма;
    Индекс = 0;
    Для Каждого СтрокаОплаты Из Платеж.РасшифровкаПлатежа Цикл
        Индекс = Индекс + 1;
        Коэффициент = Сумма / ИсходнаяСумма;
        НоваяСумма = ?(Индекс = Платеж.РасшифровкаПлатежа.Количество(), Осталось, Окр(СтрокаОплаты.СуммаПлатежа * Коэффициент, 2));
        СтрокаОплаты.СуммаПлатежа = НоваяСумма;
        СтрокаОплаты.СуммаРасчетов = Окр(СтрокаОплаты.СуммаРасчетов * Коэффициент, 2);
        СтрокаОплаты.СуммаНДС = Окр(СтрокаОплаты.СуммаНДС * Коэффициент, 2);
        Осталось = Осталось - НоваяСумма;
    КонецЦикла;
    Платеж.СуммаДокумента = Сумма;
    Платеж.СуммаУчета = Сумма;
    Если Имя = "ОперацияПоПлатежнымКартам" Тогда Платеж.СуммаКомиссииПоДоговору = Окр(Сумма * Платеж.ПроцентКомиссии / 100, 2); КонецЕсли;
    Платеж.Комментарий = "Мой Сервис: " + Контекст.checkout_id;
    Если Не Платеж.ПроверитьЗаполнение() Тогда ВызватьИсключение "Не заполнены обязательные реквизиты оплаты. Деньги не списывались."; КонецЕсли;
    Платеж.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьЭквайрингПлатежа(Платеж)
    // Те же реквизиты, которые штатная форма заполняет при выборе терминала.
    Терминал = Платеж.ЭквайринговыйТерминал;
    Если ЗначениеЗаполнено(Терминал.Организация) И Терминал.Организация <> Платеж.Организация Тогда ВызватьИсключение "Организация терминала не совпала с заказом."; КонецЕсли;
    Платеж.СпособОплаты = Перечисления.СпособыОплатыЭквайринг.ОплатаКартой;
    Платеж.ВидОперации = Перечисления.ВидыОперацийЭквайринга.ПоступлениеОплатыОтПокупателя;
    Платеж.БанковскийСчет = Терминал.БанковскийСчетЭквайринг;
    Если Не ЗначениеЗаполнено(Платеж.БанковскийСчет) Тогда ВызватьИсключение "В терминале не указан банковский счёт эквайринга."; КонецЕсли;
    Если Платеж.БанковскийСчет.ВалютаДенежныхСредств <> УправлениеНебольшойФирмойПовтИсп.ПолучитьНациональнуюВалюту() Тогда ВызватьИсключение "Банковский счёт терминала должен быть в национальной валюте."; КонецЕсли;
    Если ТипЗнч(Терминал.Касса) = Тип("СправочникСсылка.КассыККМ") Тогда Платеж.КассаККМ = Терминал.Касса; Иначе Платеж.Касса = Терминал.Касса; КонецЕсли;
    Карты = Справочники.СпособыОплаты.ВидыПлатежныхКартИПроцентыКомиссии(Терминал);
    Карта = Карты.Найти(Платеж.ВидПлатежнойКарты, "ВидПлатежнойКарты");
    Если Карта = Неопределено Тогда ВызватьИсключение "Выбранный вид карты не настроен в этом терминале."; КонецЕсли;
    Платеж.ПроцентКомиссии = Карта.ПроцентКомиссии;
    НалоговыйУчет = ЭквайринговыеОперацииСервер.ПолучитьНастройкиНалоговогоУчетаТерминала(Терминал);
    Если НалоговыйУчет.СобственныеНастройкиНалоговогоУчета Тогда
        ЗаполнитьЗначенияСвойств(Платеж, НалоговыйУчет);
        Если ЗначениеЗаполнено(НалоговыйУчет.Патент) Тогда Платеж.СпециальныйНалоговыйРежим = Перечисления.СпециальныеНалоговыеРежимы.ПСН; КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПровестиПлатежиРасчета(Контекст)
    НачатьТранзакцию();
    Попытка
        Для Каждого Имя Из СтрРазделить("ОперацияПоПлатежнымКартам,ПоступлениеВКассу", ",") Цикл
            Платеж = ПлатежПоРасчету(Имя, Контекст.checkout_id);
            Если Платеж = Неопределено Тогда Продолжить; КонецЕсли;
            Если Имя = "ОперацияПоПлатежнымКартам" Тогда
                Если ПустаяСтрока(Контекст.order.bank_reference) Тогда ВызватьИсключение "Нет подтверждения банковской операции."; КонецЕсли;
                Если ПустаяСтрока(Платеж.СсылочныйНомер) Тогда
                    // Восстановление после подтверждённой администратором сверки RRN.
                    Платеж.СсылочныйНомер = Контекст.order.bank_reference;
                    Платеж.Записать(РежимЗаписиДокумента.Запись);
                ИначеЕсли Платеж.СсылочныйНомер <> Контекст.order.bank_reference Тогда
                    ВызватьИсключение "RRN в 1С и на сервере различаются. Нужна сверка.";
                КонецЕсли;
            КонецЕсли;
            Если Не Платеж.Проведен Тогда Платеж.Записать(РежимЗаписиДокумента.Проведение); КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НачатьОплатуКартой(Действие)
    Если Не МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда Сообщить("Выберите рабочее место подключаемого оборудования 1С."); Возврат; КонецЕсли;
    Разрешение = РазрешитьОборудование("card_started");
    Если Не Разрешение Тогда Сообщить("Операция уже запускалась. Выполните сверку результата терминала."); Возврат; КонецЕсли;
    ЭтотОбъект["ОборудованиеЗанято"] = Истина;
    Попытка
        ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
        ПараметрыОперации.ТипТранзакции = "AuthorizeSales";
        ПараметрыОперации.СуммаОперации = Действие.Сумма;
        ПараметрыОперации.НомерЧека = "";
        ПараметрыОперации.СсылочныйНомер = "";
        Оповещение = Новый ОписаниеОповещения("ОплатаКартойЗавершение", ЭтотОбъект, Действие.Контекст);
        ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение, УникальныйИдентификатор, Действие.ПараметрыЭТ.ИдентификаторУстройства, ПараметрыОперации, , Действие.ПараметрыККТ.ИдентификаторУстройства);
    Исключение
        ЭтотОбъект["ОборудованиеЗанято"] = Ложь;
        ОшибкаОборудования("Не удалось получить достоверный результат терминала.");
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОплатаКартойЗавершение(Результат, Контекст) Экспорт
    ЭтотОбъект["ОборудованиеЗанято"] = Ложь;
    Попытка
        Если Не Результат.Результат Тогда ОшибкаОборудования("Терминал не подтвердил оплату: " + Результат.ОписаниеОшибки); Возврат; КонецЕсли;
        Действие = ЗапомнитьОплатуКартой(Результат, Контекст);
        Если Действие <> Неопределено Тогда НачатьПечатьЧека(Действие); КонецЕсли;
    Исключение Сообщить("Результат терминала получен. Не повторяйте списание: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ЗапомнитьОплатуКартой(Результат, Контекст)
    Платеж = ПлатежПоРасчету("ОперацияПоПлатежнымКартам", Контекст.checkout_id);
    Платеж.СсылочныйНомер = Результат.СсылочныйНомер;
    Платеж.НомерЧекаЭТ = Результат.НомерЧекаЭТ;
    Платеж.НомерПлатежнойКарты = Результат.НомерКарты;
    Если Результат.Свойство("ВидОплатыНаТерминалеКод") Тогда Платеж.КодСпособаОплатыЭТ = ЧислоИзJSON(Результат.ВидОплатыНаТерминалеКод); КонецЕсли;
    Если Результат.Свойство("ИдентификаторQRОперации") Тогда Платеж.ИдентификаторQRОперации = Результат.ИдентификаторQRОперации; КонецЕсли;
    Платеж.Записать(РежимЗаписиДокумента.Запись);
    СобытиеРасчета(Контекст, "card_succeeded", Новый Структура("bank_reference", Результат.СсылочныйНомер));
    Возврат ДействиеРасчета(Контекст);
КонецФункции

&НаСервере
Функция РазрешитьОборудование(Событие)
    Контекст = ИзJSON(ЭтотОбъект["КонтекстРасчета"]);
    Результат = СобытиеРасчета(Контекст, Событие);
    Возврат Результат.Свойство("dispatch") И Результат.dispatch;
КонецФункции

&НаКлиенте
Процедура НачатьПечатьЧека(Действие)
    Если Не МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда Сообщить("Выберите рабочее место подключаемого оборудования 1С."); Возврат; КонецЕсли;
    Попытка
        ДанныеДействия = ПараметрыЧекаНаСервере(Действие.Контекст);
        ЭтотОбъект["ОборудованиеЗанято"] = Истина;
        Оповещение = Новый ОписаниеОповещения("ПроверкаМаркировкиЗавершение", ЭтотОбъект, ДанныеДействия);
        РозничныеПродажиКлиент.ПроверитьКодМаркировкиСредствамиККТ(ДанныеДействия.ОбщиеПараметры, ЭтотОбъект, "Напечатать чек", Оповещение);
    Исключение ЭтотОбъект["ОборудованиеЗанято"] = Ложь; Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПараметрыЧекаНаСервере(Контекст)
    Настройки = Настройка("Точка_" + Контекст.point, Новый Структура);
    Касса = УправлениеНебольшойФирмойПовтИсп.ПолучитьПараметрыКассыККМ(СсылкаНастройки(Настройки, "fiscal"));
    Ссылка = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Контекст.order.order_ref));
    Документ = Ссылка.ПолучитьОбъект();
    Если Документ.НомерЧекаККМ <> 0 Тогда ВызватьИсключение "По заказу уже есть фискальный чек. Повторная печать нового чека запрещена."; КонецЕсли;
    ЗначениеВРеквизитФормы(Документ, "Объект");
    ОбщиеПараметры = РозничныеПродажиСервер.ПолучитьДанныеДляФискализации(Ссылка, Касса.ИдентификаторУстройства);
    Если ОбщиеПараметры = Неопределено Тогда ВызватьИсключение "Штатный механизм не подготовил данные чека. Проверьте сообщения 1С."; КонецЕсли;
    ОбщиеПараметры.ТаблицаОплат.Очистить();
    Если ЧислоИзJSON(Контекст.order.cash) > 0 Тогда ОбщиеПараметры.ТаблицаОплат.Добавить(Новый Структура("ТипОплаты,Наименование,Сумма", Перечисления.ТипыОплатыККТ.Наличные, "Наличные", ЧислоИзJSON(Контекст.order.cash))); КонецЕсли;
    Если ЧислоИзJSON(Контекст.order.card) > 0 Тогда ОбщиеПараметры.ТаблицаОплат.Добавить(Новый Структура("ТипОплаты,Наименование,Сумма", Перечисления.ТипыОплатыККТ.Электронно, "Карта", ЧислоИзJSON(Контекст.order.card))); КонецЕсли;
    ИтогЧека = 0;
    Для Каждого Позиция Из ОбщиеПараметры.ПозицииЧека Цикл ИтогЧека = ИтогЧека + Позиция.Сумма; КонецЦикла;
    Если Окр(ИтогЧека, 2) <> Документ.СуммаДокумента Тогда ВызватьИсключение "Итог фискальных строк не совпал с заказом. Чек не отправлен на ККТ."; КонецЕсли;
    Возврат Новый Структура("ОбщиеПараметры,ИдентификаторУстройстваФР,Контекст", ОбщиеПараметры, Касса.ИдентификаторУстройства, Контекст);
КонецФункции

&НаКлиенте
Процедура ПроверкаМаркировкиЗавершение(Результат, ДанныеДействия) Экспорт
    ЭтотОбъект["ОборудованиеЗанято"] = Ложь;
    Если Не ШтрихкодированиеИСМПКлиент.РезультатПроверкиСредствамиККТТребуетФискализации(Результат) Тогда Возврат; КонецЕсли;
    Попытка
        Если Не РазрешитьОборудование("fiscal_started") Тогда Сообщить("Чек уже отправлялся. Сверьте результат ККТ."); Возврат; КонецЕсли;
        ЭтотОбъект["ОборудованиеЗанято"] = Истина;
        ДанныеДействия.ОбщиеПараметры.ДатаВремя = ОбщегоНазначенияКлиент.ДатаСеанса();
        Оповещение = Новый ОписаниеОповещения("ПечатьЧекаЗавершение", ЭтотОбъект, ДанныеДействия.Контекст);
        ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ДанныеДействия.ИдентификаторУстройстваФР, ДанныеДействия.ОбщиеПараметры);
    Исключение ЭтотОбъект["ОборудованиеЗанято"] = Ложь; Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧекаЗавершение(Результат, Контекст) Экспорт
    ЭтотОбъект["ОборудованиеЗанято"] = Ложь;
    Попытка
        Если Не Результат.Результат Тогда ОшибкаОборудования("ККТ не подтвердила чек: " + Результат.ОписаниеОшибки); Возврат; КонецЕсли;
        СохранитьУспешныйЧек(Результат, Контекст);
    Исключение Сообщить("Не печатайте повторный чек: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьУспешныйЧек(Результат, Контекст)
    Если Результат.НомерЧекаККТ <= 0 Тогда ВызватьИсключение "ККТ не вернула номер чека. Нужна сверка."; КонецЕсли;
    // Сначала сохраняем подтверждение локально: при недоступности сайта
    // продолжение отправит именно этот результат, без новой команды ККТ.
    НачатьТранзакцию();
    Попытка
        Документ = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Контекст.order.order_ref)).ПолучитьОбъект();
        Документ.НомерЧекаККМ = Результат.НомерЧекаККТ;
        Документ.НомерСменыККМ = Результат.НомерСменыККТ;
        Документ.Записать(РежимЗаписиДокумента.Запись);
        Для Каждого Имя Из СтрРазделить("ОперацияПоПлатежнымКартам,ПоступлениеВКассу", ",") Цикл
            Платеж = ПлатежПоРасчету(Имя, Контекст.checkout_id);
            Если Платеж <> Неопределено Тогда
                Платеж.НомерЧекаККМ = Результат.НомерЧекаККТ;
                Платеж.НомерСменыККМ = Результат.НомерСменыККТ;
                Платеж.Записать(РежимЗаписиДокумента.Запись);
            КонецЕсли;
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    Чек = Новый Структура("number,shift", Формат(Результат.НомерЧекаККТ, "ЧГ=0"), Формат(Результат.НомерСменыККТ, "ЧГ=0"));
    СобытиеРасчета(Контекст, "fiscal_succeeded", Новый Структура("receipt", Чек));
    Данные = ИзJSON(ЭтотОбъект["СостояниеJSON"]);
    Данные.Вставить("opened", ОткрытьЗапись(Контекст.id));
    Данные.Вставить("message", "Оплата принята, кассовый чек зарегистрирован. Данные переданы клиенту. Заказ-наряд не проведён.");
    ОбновитьЗаписи(Данные);
    ПоказатьИнтерфейс(Данные);
КонецПроцедуры

&НаСервере
Процедура ОшибкаОборудования(Текст)
    Контекст = ИзJSON(ЭтотОбъект["КонтекстРасчета"]);
    Попытка СобытиеРасчета(Контекст, "review"); Исключение Сообщить("Сайт недоступен; статус расчёта нужно сверить после восстановления связи."); КонецПопытки;
    Данные = ИзJSON(ЭтотОбъект["СостояниеJSON"]);
    Данные.Вставить("message", Текст + " Повторная операция автоматически не запускается.");
    Данные.Вставить("error", Истина);
    Попытка Данные.Вставить("opened", ОткрытьЗапись(Контекст.id)); Исключение КонецПопытки;
    ПоказатьИнтерфейс(Данные);
КонецПроцедуры
