// Целевая платформа 8.5.1.1529, Автосервис 3.0.14.159.
// HTML отвечает за представление. HTTP, запись документов и оборудование — в 1С.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Мой Сервис — мастер 2.0.1";
    Реквизиты = Новый Массив;
    Для Каждого Имя Из СтрРазделить("HTML,СостояниеJSON,АдресСервера,Логин,Токен,Обновление,КонтекстРасчета", ",") Цикл
        Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка")));
    КонецЦикла;
    Реквизиты.Добавить(Новый РеквизитФормы("ОборудованиеЗанято", Новый ОписаниеТипов("Булево")));
    Если Метаданные.Документы.Найти("асЗаказНаряд") <> Неопределено Тогда
        Реквизиты.Добавить(Новый РеквизитФормы("Объект", Новый ОписаниеТипов("ДокументОбъект.асЗаказНаряд")));
    КонецЕсли;
    ИзменитьРеквизиты(Реквизиты);
    Поле = Элементы.Добавить("РабочееМесто", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеHTMLДокумента;
    Поле.ПутьКДанным = "HTML";
    Поле.РастягиватьПоГоризонтали = Истина;
    Поле.РастягиватьПоВертикали = Истина;
    Поле.УстановитьДействие("ПриНажатии", "HTMLПриНажатии");
    ЭтотОбъект["АдресСервера"] = Настройка("Адрес", "https://moi-servis.ru");
    ЭтотОбъект["Логин"] = Настройка("Логин", "");
    Данные = Новый Структура("connected,url,phone,day,ui", Ложь, ЭтотОбъект["АдресСервера"], ЭтотОбъект["Логин"], Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"), Новый Структура);
    ПоказатьИнтерфейс(Данные);
КонецПроцедуры

&НаКлиенте
Процедура HTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
    Адрес = "";
    Попытка Адрес = Строка(ДанныеСобытия.Href); Исключение Возврат; КонецПопытки;
    Позиция = СтрНайти(Адрес, "#ms=");
    Если Позиция = 0 Тогда Возврат; КонецЕсли;
    СтандартнаяОбработка = Ложь;
    Если ЭтотОбъект["ОборудованиеЗанято"] Тогда Возврат; КонецЕсли;
    Попытка
        Закодировано = Сред(Адрес, Позиция + 4);
        Попытка
            ИмяСсылки = Строка(ДанныеСобытия.Name);
            Если Не ПустаяСтрока(ИмяСсылки) Тогда Закодировано = ИмяСсылки; КонецЕсли;
        Исключение КонецПопытки;
        Действие = ВыполнитьЗакодированнуюКоманду(Закодировано);
        Если Действие <> Неопределено Тогда
            Если Действие.Действие = "Банк" Тогда НачатьОплатуКартой(Действие);
            ИначеЕсли Действие.Действие = "Чек" Тогда НачатьПечатьЧека(Действие);
            КонецЕсли;
        КонецЕсли;
    Исключение
        Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗакодированнуюКоманду(Закодировано)
    // URL-декодирование недоступно в тонком клиенте платформы.
    Если СтрДлина(Закодировано) > 12000000 Тогда ВызватьИсключение "Слишком большой объём данных формы."; КонецЕсли;
    КомандаJSON = РаскодироватьСтроку(Закодировано, СпособКодированияСтроки.КодировкаURL);
    Если СтрДлина(КомандаJSON) > 2000000 Тогда ВызватьИсключение "Слишком большой объём данных формы."; КонецЕсли;
    Возврат ВыполнитьКомандуСервера(КомандаJSON);
КонецФункции

&НаСервере
Функция ВыполнитьКомандуСервера(Текст)
    ЗапросФормы = ИзJSON(Текст);
    ИмяКоманды = Строка(ЗапросФормы.command);
    Параметры = ЗапросФормы.payload;
    Данные = ИзJSON(ЭтотОбъект["СостояниеJSON"]);
    Данные.Вставить("ui", ЗапросФормы.ui);
    Данные.Вставить("opened", Неопределено);
    Данные.Вставить("message", "");
    Данные.Вставить("error", Ложь);
    Действие = Неопределено;
    Попытка
        Если ИмяКоманды = "login" Тогда
            ВойтиВСервер(Параметры, Данные);
        ИначеЕсли ИмяКоманды = "logout" Тогда
            ЭтотОбъект["Токен"] = "";
            ЭтотОбъект["Обновление"] = "";
            Данные = Новый Структура("connected,url,phone,day,ui", Ложь, ЭтотОбъект["АдресСервера"], ЭтотОбъект["Логин"], Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd"), Новый Структура);
        ИначеЕсли ПустаяСтрока(ЭтотОбъект["Токен"]) Тогда
            ВызватьИсключение "Сначала войдите под учётной записью сотрудника.";
        ИначеЕсли ИмяКоманды = "refresh" Тогда
            Данные.Вставить("point", Параметры.point);
            Данные.Вставить("day", Параметры.day);
            ОбновитьЗаписи(Данные);
        ИначеЕсли ИмяКоманды = "open" Тогда
            Данные.Вставить("opened", ОткрытьЗапись(Параметры.id));
            Данные.Вставить("products", Новый Массив);
        ИначеЕсли ИмяКоманды = "save-settings" Тогда
            Ключ = ПроверитьUUID(Параметры.point);
            ПроверитьНастройки(Параметры.settings);
            ЗапомнитьНастройку("Точка_" + Ключ, Параметры.settings);
            Данные.Вставить("settings", Параметры.settings);
            Данные.Вставить("message", "Настройки выбранной точки сохранены.");
        ИначеЕсли ИмяКоманды = "save-booking" Тогда
            СохранитьПравкуЗаписи(Параметры.tab);
            Данные.Вставить("opened", ОткрытьЗапись(Параметры.id, Параметры.tab));
            ОбновитьЗаписи(Данные);
            Данные.Вставить("message", "Запись изменена на сервере. Клиент увидит обновлённые данные в приложении.");
        ИначеЕсли ИмяКоманды = "start" Или ИмяКоманды = "cancel" Или ИмяКоманды = "no-show" Тогда
            ТелоДействия = Новый Структура;
            Если ИмяКоманды <> "start" Тогда ТелоДействия.Вставить("reason", Параметры.reason); КонецЕсли;
            API("/api/v1/master/bookings/" + ПроверитьUUID(Параметры.id) + "/" + ИмяКоманды + "/", ТелоДействия);
            Данные.Вставить("opened", ОткрытьЗапись(Параметры.id, Параметры.tab));
            ОбновитьЗаписи(Данные);
            Данные.Вставить("message", "Статус записи изменён на сервере.");
        ИначеЕсли ИмяКоманды = "products" Тогда
            Данные.Вставить("products", НайтиНоменклатуру(Параметры));
        ИначеЕсли ИмяКоманды = "save-order" Тогда
            СохранитьЗаказИОтправить(Параметры.tab, Параметры.point);
            Данные.Вставить("opened", ОткрытьЗапись(Параметры.id));
            ОбновитьЗаписи(Данные);
            Данные.Вставить("message", "Заказ-наряд записан без проведения. Состав обслуживания сохранён на сервере.");
        ИначеЕсли ИмяКоманды = "quote" Тогда
            Если Параметры.tab.order <> Неопределено И Параметры.tab.order.state <> "draft" Тогда
                Данные.Вставить("opened", ОткрытьЗапись(Параметры.id));
            Иначе
                СохранитьЗаказИОтправить(Параметры.tab, Параметры.point);
                Сумма = ЧислоИзJSON(Параметры.tab.order.total);
                Котировка = API("/api/v1/onec/workplace/bookings/" + ПроверитьUUID(Параметры.id) + "/quote/?total=" + ЧислоВJSON(Сумма));
                Параметры.tab.Вставить("quote", Котировка);
                Параметры.tab.Вставить("checkout", Новый Структура("points,method,cash", 0, "card", 0));
                Данные.Вставить("opened", Параметры.tab);
            КонецЕсли;
        ИначеЕсли ИмяКоманды = "pay" Тогда
            Действие = ПодготовитьРасчет(Параметры, Данные);
        ИначеЕсли ИмяКоманды = "resume" Тогда
            Действие = ПродолжитьРасчет(Параметры.id, Данные);
        ИначеЕсли ИмяКоманды = "slots" Тогда
            Параметры.tab.Вставить("slots", СлотыЗаписи(Параметры.tab));
            Данные.Вставить("opened", Параметры.tab);
        ИначеЕсли ИмяКоманды = "walkin-slots" Тогда
            ОтветСлотов = API("/api/v1/master/walk-in/slots/?service_point=" + ПроверитьUUID(Параметры.point) + "&date=" + КодироватьСтроку(Параметры.day, СпособКодированияСтроки.КодировкаURL));
            Данные.Вставить("walkin_slots", ОтветСлотов.slots);
        ИначеЕсли ИмяКоманды = "lookup-client" Тогда
            Найден = API("/api/v1/master/walk-in/lookup/?phone=" + КодироватьСтроку(Параметры.phone, СпособКодированияСтроки.КодировкаURL));
            Если Не Найден.is_client Тогда ВызватьИсключение "Этот номер принадлежит сотруднику, выберите номер клиента."; КонецЕсли;
            Данные.ui.walkform.Вставить("full_name", Найден.full_name);
            Данные.ui.walkform.Вставить("car_model", Найден.car_model);
            Данные.ui.walkform.Вставить("car_plate", Найден.car_plate);
        ИначеЕсли ИмяКоманды = "walkin" Тогда
            Данные.ui.Вставить("walkin", Истина);
            Данные.Вставить("message", "Укажите телефон, имя, машину и время в форме записи клиента.");
        ИначеЕсли ИмяКоманды = "create-booking" Тогда
            НоваяЗапись = API("/api/v1/master/bookings/", Параметры.booking);
            ОбновитьЗаписи(Данные);
            Данные.Вставить("opened", ОткрытьЗапись(НоваяЗапись.id));
            Данные.ui.Вставить("walkin", Ложь);
        ИначеЕсли ИмяКоманды = "cancel-checkout" Тогда
            ОтменитьПодготовленныйРасчет(Параметры.id);
            Данные.Вставить("opened", ОткрытьЗапись(Параметры.id));
            Данные.Вставить("message", "Подготовленный расчёт отменён. Резерв баллов снят.");
        ИначеЕсли ИмяКоманды = "reload-order" Тогда
            Данные.Вставить("opened", ОткрытьЗапись(Параметры.id));
        Иначе
            ВызватьИсключение "Неизвестная команда рабочего места.";
        КонецЕсли;
    Исключение
        Если Параметры.Свойство("tab") И Параметры.tab <> Неопределено Тогда Данные.Вставить("opened", Параметры.tab); КонецЕсли;
        Данные.Вставить("message", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Данные.Вставить("error", Истина);
        Если ИмяКоманды = "pay" Или ИмяКоманды = "resume" Или ИмяКоманды = "cancel-checkout" Тогда
            Попытка Данные.Вставить("opened", ОткрытьЗапись(Параметры.id)); Исключение КонецПопытки;
        КонецЕсли;
    КонецПопытки;
    ПоказатьИнтерфейс(Данные);
    Возврат Действие;
КонецФункции

&НаСервере
Процедура ВойтиВСервер(Параметры, Данные)
    ЭтотОбъект["АдресСервера"] = ПроверитьАдресСервера(Параметры.url);
    Ответ = HTTPВызов("/api/v1/auth/staff/login/", Новый Структура("phone,password", Параметры.phone, Параметры.password), "");
    Если Ответ.Код <> 200 Тогда ВызватьИсключение ТекстОшибкиHTTP(Ответ); КонецЕсли;
    ЭтотОбъект["Токен"] = Ответ.Данные.access;
    ЭтотОбъект["Обновление"] = Ответ.Данные.refresh;
    ЭтотОбъект["Логин"] = Параметры.phone;
    ЗапомнитьНастройку("Адрес", ЭтотОбъект["АдресСервера"]);
    ЗапомнитьНастройку("Логин", ЭтотОбъект["Логин"]);
    Данные.Вставить("connected", Истина);
    Данные.Вставить("staff", Ответ.Данные.user.full_name);
    Каталог = API("/api/v1/master/service-categories/");
    Данные.Вставить("points", Каталог.points);
    Данные.Вставить("categories", Каталог.categories);
    Если Каталог.points.Количество() > 0 Тогда Данные.Вставить("point", Каталог.points[0].id); КонецЕсли;
    Данные.Вставить("local_choices", ЛокальныеВариантыНастроек());
    ОбновитьЗаписи(Данные);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаписи(Данные)
    Если Не Данные.Свойство("point") Тогда Данные.Вставить("bookings", Новый Массив); Возврат; КонецЕсли;
    Путь = "/api/v1/master/bookings/?service_point=" + ПроверитьUUID(Данные.point) + "&date=" + КодироватьСтроку(Данные.day, СпособКодированияСтроки.КодировкаURL);
    Записи = Новый Массив;
    НомерСтраницы = 1;
    Пока Истина Цикл
        Ответ = API(Путь + "&page=" + Формат(НомерСтраницы, "ЧГ=0"));
        Строки = Ответ;
        ЕстьЕще = Ложь;
        Если ТипЗнч(Ответ) = Тип("Структура") Тогда
            Строки = Ответ.results;
            ЕстьЕще = Ответ.Свойство("next") И Ответ.next <> Неопределено;
        КонецЕсли;
        Для Каждого Запись Из Строки Цикл Записи.Добавить(Запись); КонецЦикла;
        Если Не ЕстьЕще Тогда Прервать; КонецЕсли;
        НомерСтраницы = НомерСтраницы + 1;
        Если НомерСтраницы > 100 Тогда ВызватьИсключение "Слишком много страниц записей. Уточните дату."; КонецЕсли;
    КонецЦикла;
    Данные.Вставить("bookings", Записи);
    Данные.Вставить("settings", Настройка("Точка_" + Данные.point, Новый Структура));
КонецПроцедуры

&НаСервере
Функция ОткрытьЗапись(Идентификатор, СохранитьРедактор = Неопределено)
    Ид = ПроверитьUUID(Идентификатор);
    Запись = API("/api/v1/master/bookings/" + Ид + "/");
    Ответ = API("/api/v1/onec/workplace/bookings/" + Ид + "/order/");
    Таб = Новый Структура("booking,order,lines,recommendations,dirty", Запись, Ответ.order, Новый Массив, "", Ложь);
    Если Ответ.order <> Неопределено Тогда
        Таб.lines = Ответ.order.lines;
        Таб.recommendations = Ответ.order.recommendations;
    КонецЕсли;
    Если СохранитьРедактор <> Неопределено Тогда
        Таб.lines = СохранитьРедактор.lines;
        Таб.recommendations = СохранитьРедактор.recommendations;
        Таб.dirty = Истина;
    КонецЕсли;
    ДополнитьЛокальнымиДанными(Таб);
    Если Ответ.order <> Неопределено И Ответ.order.state <> "draft" Тогда
        Метод = ?(ЧислоИзJSON(Ответ.order.card) = 0, "cash", ?(ЧислоИзJSON(Ответ.order.cash) = 0, "card", "mixed"));
        Таб.Вставить("checkout", Новый Структура("points,method,cash", Ответ.order.points, Метод, Ответ.order.cash));
        Таб.Вставить("quote", Новый Структура("max_spend", Ответ.order.points));
    КонецЕсли;
    Возврат Таб;
КонецФункции

&НаСервере
Процедура СохранитьПравкуЗаписи(Таб)
    Запись = Таб.booking;
    Тело = Новый Структура("expected_version,car_model,car_plate,car_vin,comment", Запись.version, Запись.car_model, Запись.car_plate, Запись.car_vin, Запись.client_comment);
    Если Запись.car_mileage <> "" И Запись.car_mileage <> Неопределено Тогда Тело.Вставить("car_mileage", Число(Запись.car_mileage)); КонецЕсли;
    Если Таб.Свойство("service") И Не ПустаяСтрока(Таб.service) Тогда Тело.Вставить("service", ПроверитьUUID(Таб.service)); КонецЕсли;
    Если Таб.Свойство("start_at") Тогда
        Тело.Вставить("start_at", Таб.start_at);
    ИначеЕсли Таб.Свойство("start_local") Тогда
        Тело.Вставить("start_local", Таб.start_local);
    КонецЕсли;
    Свежая = API("/api/v1/master/bookings/" + ПроверитьUUID(Запись.id) + "/edit/", Тело);
    Таб.booking = Свежая;
    Таб.Удалить("service");
    Таб.Удалить("start_at");
    Таб.Удалить("start_local");
КонецПроцедуры

&НаСервере
Функция СлотыЗаписи(Таб)
    День = Лев(Таб.start_local, 10);
    Ответ = API("/api/v1/master/walk-in/slots/?service_point=" + ПроверитьUUID(Таб.booking.service_point) + "&date=" + День);
    Возврат Ответ.slots;
КонецФункции

&НаСервере
Процедура ПоказатьИнтерфейс(Данные)
    Если Данные.Свойство("opened") И Данные.opened <> Неопределено И Данные.ui.Свойство("tabs") Тогда
        Для Индекс = 0 По Данные.ui.tabs.Количество() - 1 Цикл
            Если Данные.ui.tabs[Индекс].booking.id = Данные.opened.booking.id Тогда Данные.ui.tabs[Индекс] = Данные.opened; КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    ЭтотОбъект["СостояниеJSON"] = ВJSON(Данные);
    JSONБезHTML = СтрЗаменить(ЭтотОбъект["СостояниеJSON"], "<", "\u003c");
    JSONБезHTML = СтрЗаменить(JSONБезHTML, ">", "\u003e");
    JSONБезHTML = СтрЗаменить(JSONБезHTML, Символ(8232), "\u2028");
    JSONБезHTML = СтрЗаменить(JSONБезHTML, Символ(8233), "\u2029");
    ЭтотОбъект["HTML"] = СтрЗаменить(ШаблонИнтерфейса(), "__DATA_JSON__", JSONБезHTML);
КонецПроцедуры

&НаСервере
Функция Настройка(Ключ, ПоУмолчанию)
    Значение = ХранилищеОбщихНастроек.Загрузить("МойСервисРабочееМесто", Ключ);
    Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
КонецФункции

&НаСервере
Процедура ЗапомнитьНастройку(Ключ, Значение)
    ХранилищеОбщихНастроек.Сохранить("МойСервисРабочееМесто", Ключ, Значение);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьUUID(Значение)
    Возврат Строка(Новый УникальныйИдентификатор(Строка(Значение)));
КонецФункции

&НаСервереБезКонтекста
Функция ИтогСтрок(Строки)
    Сумма = 0;
    Для Каждого Строка Из Строки Цикл
        Если ЧислоИзJSON(Строка.quantity) <= 0 Или ЧислоИзJSON(Строка.price) < 0 Тогда ВызватьИсключение "Проверьте количество и цену строк."; КонецЕсли;
        Сумма = Сумма + ?(Строка.Свойство("amount"), ЧислоИзJSON(Строка.amount), Окр(ЧислоИзJSON(Строка.quantity) * ЧислоИзJSON(Строка.price), 2));
    КонецЦикла;
    Возврат Сумма;
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоВJSON(Значение)
    Возврат СтрЗаменить(Формат(Значение, "ЧГ=0;ЧДЦ=2;ЧРД=.;ЧН=0"), " ", "");
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
    Если ЭтотОбъект["ОборудованиеЗанято"] Тогда
        Отказ = Истина;
        Сообщить("Дождитесь результата терминала или ККТ. Закрытие во время операции заблокировано.");
    Иначе
        ТекстПредупреждения = "Сохраните изменения открытых заказов перед закрытием рабочего места. Закрыть обработку?";
    КонецЕсли;
КонецПроцедуры
