&НаСервере
Функция API(Путь, Тело = Неопределено)
    Ответ = HTTPВызов(Путь, Тело, ЭтотОбъект["Токен"]);
    Если Ответ.Код = 401 И Не ПустаяСтрока(ЭтотОбъект["Обновление"]) Тогда
        НовыйВход = HTTPВызов("/api/v1/auth/token/refresh/", Новый Структура("refresh", ЭтотОбъект["Обновление"]), "");
        Если НовыйВход.Код = 200 Тогда
            ЭтотОбъект["Токен"] = НовыйВход.Данные.access;
            Если НовыйВход.Данные.Свойство("refresh") Тогда ЭтотОбъект["Обновление"] = НовыйВход.Данные.refresh; КонецЕсли;
            Ответ = HTTPВызов(Путь, Тело, ЭтотОбъект["Токен"]);
        КонецЕсли;
    КонецЕсли;
    Если Ответ.Код < 200 Или Ответ.Код >= 300 Или Не ПустаяСтрока(Ответ.Ошибка) Тогда ВызватьИсключение ТекстОшибкиHTTP(Ответ); КонецЕсли;
    Возврат Ответ.Данные;
КонецФункции

&НаСервере
Функция HTTPВызов(Путь, Тело, Токен)
    Если Не СтрНачинаетсяС(Путь, "/api/v1/") Или СтрНайти(Путь, Символы.ПС) > 0 Тогда ВызватьИсключение "Недопустимый путь API."; КонецЕсли;
    Части = ЧастиАдреса(ЭтотОбъект["АдресСервера"]);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Accept", "application/json");
    Если Не ПустаяСтрока(Токен) Тогда Заголовки.Вставить("Authorization", "Bearer " + Токен); КонецЕсли;
    Результат = Новый Структура("Код,Данные,Ошибка", 0, Неопределено, "");
    Попытка
        TLS = ?(Части.Защита, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
        Соединение = Новый HTTPСоединение(Части.Хост, Части.Порт, , , , 30, TLS);
        Запрос = Новый HTTPЗапрос(Части.Префикс + Путь, Заголовки);
        Если Тело = Неопределено Тогда
            Ответ = Соединение.Получить(Запрос);
        Иначе
            Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
            Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
            Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        КонецЕсли;
        Результат.Код = Ответ.КодСостояния;
        Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
        Если СтрДлина(Текст) > 10000000 Тогда ВызватьИсключение "Слишком большой ответ сервера."; КонецЕсли;
        Если Не ПустаяСтрока(Текст) Тогда
            Попытка Результат.Данные = ИзJSON(Текст); Исключение Результат.Ошибка = "Сервер вернул ответ не в формате JSON."; КонецПопытки;
        КонецЕсли;
    Исключение
        Результат.Ошибка = "Не удалось связаться с сервером. Результат запроса мог сохраниться; повтор платежа автоматически не выполняется. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЧастиАдреса(Адрес)
    Остаток = СокрЛП(Адрес);
    Защита = СтрНачинаетсяС(НРег(Остаток), "https://");
    Если Защита Тогда Остаток = Сред(Остаток, 9);
    ИначеЕсли СтрНачинаетсяС(НРег(Остаток), "http://") Тогда Остаток = Сред(Остаток, 8);
    Иначе ВызватьИсключение "Укажите адрес вида https://moi-servis.ru"; КонецЕсли;
    Для Каждого Запрещенный Из СтрРазделить("@,?,#", ",") Цикл
        Если СтрНайти(Остаток, Запрещенный) > 0 Тогда ВызватьИсключение "Адрес не должен содержать пароль, параметры или фрагмент."; КонецЕсли;
    КонецЦикла;
    Если СтрНайти(Остаток, Символы.ПС) > 0 Или СтрНайти(Остаток, Символы.ВК) > 0 Тогда ВызватьИсключение "Некорректный адрес."; КонецЕсли;
    Префикс = "";
    Слеш = СтрНайти(Остаток, "/");
    Если Слеш > 0 Тогда Префикс = Сред(Остаток, Слеш); Остаток = Лев(Остаток, Слеш - 1); КонецЕсли;
    Пока СтрЗаканчиваетсяНа(Префикс, "/") Цикл Префикс = Лев(Префикс, СтрДлина(Префикс) - 1); КонецЦикла;
    Порт = ?(Защита, 443, 80);
    Двоеточие = СтрНайти(Остаток, ":");
    Если Двоеточие > 0 Тогда Порт = Число(Сред(Остаток, Двоеточие + 1)); Остаток = Лев(Остаток, Двоеточие - 1); КонецЕсли;
    Если ПустаяСтрока(Остаток) Или СтрНайти(Остаток, " ") > 0 Или Порт < 1 Или Порт > 65535 Тогда ВызватьИсключение "Проверьте адрес и порт сервера."; КонецЕсли;
    Если Не Защита И Остаток <> "127.0.0.1" И НРег(Остаток) <> "localhost" Тогда ВызватьИсключение "Для удалённого сервера используйте HTTPS."; КонецЕсли;
    Возврат Новый Структура("Хост,Порт,Защита,Префикс", Остаток, Порт, Защита, Префикс);
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьАдресСервера(Адрес)
    ЧастиАдреса(Адрес);
    Возврат СокрЛП(Адрес);
КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиHTTP(Ответ)
    Если Не ПустаяСтрока(Ответ.Ошибка) Тогда Возврат Ответ.Ошибка; КонецЕсли;
    Если ТипЗнч(Ответ.Данные) = Тип("Структура") И Ответ.Данные.Свойство("error") Тогда
        Сообщение = Ответ.Данные.error.message;
        Если Ответ.Данные.error.Свойство("details") И Ответ.Данные.error.details.Свойство("fields") Тогда
            Сообщение = Сообщение + ": " + ОшибкиПолейHTTP(Ответ.Данные.error.details.fields);
        КонецЕсли;
        Возврат Сообщение;
    КонецЕсли;
    Возврат "Сервер ответил HTTP " + Формат(Ответ.Код, "ЧГ=0") + ". Проверьте установку серверной части рабочего места.";
КонецФункции

&НаСервереБезКонтекста
Функция ОшибкиПолейHTTP(Значение)
    Если ТипЗнч(Значение) = Тип("Структура") Тогда
        Имена = Новый Структура("phone,password,car_model,car_plate,car_vin,car_mileage,start_local,start_at,service,quantity,price,lines,recommendations", "Телефон", "Пароль", "Автомобиль", "Госномер", "VIN", "Пробег", "Время", "Время", "Услуга", "Количество", "Цена", "Строки заказа", "Рекомендации");
        Части = Новый Массив;
        Для Каждого Пара Из Значение Цикл
            Название = "";
            Имена.Свойство(Пара.Ключ, Название);
            Части.Добавить(?(ПустаяСтрока(Название), "", Название + ": ") + ОшибкиПолейHTTP(Пара.Значение));
        КонецЦикла;
        Возврат Лев(СтрСоединить(Части, "; "), 2000);
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        Части = Новый Массив;
        Для Каждого Элемент Из Значение Цикл Части.Добавить(ОшибкиПолейHTTP(Элемент)); КонецЦикла;
        Возврат Лев(СтрСоединить(Части, "; "), 2000);
    КонецЕсли;
    Возврат Строка(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция ВJSON(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ИзJSON(Текст)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Попытка Значение = ПрочитатьJSON(Чтение); Исключение Чтение.Закрыть(); ВызватьИсключение; КонецПопытки;
    Чтение.Закрыть();
    Возврат Значение;
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзJSON(Значение)
    Если ТипЗнч(Значение) = Тип("Число") Тогда Возврат Значение; КонецЕсли;
    Результат = ИзJSON(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."));
    Если ТипЗнч(Результат) <> Тип("Число") Тогда ВызватьИсключение "Ожидалось число."; КонецЕсли;
    Возврат Результат;
КонецФункции
