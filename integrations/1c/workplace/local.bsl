&НаСервереБезКонтекста
Функция КаталогиНастроек()
    Возврат Новый Структура("workshop,organization,repair,cashbox,fiscal,terminal,cardtype,price,workprice", "СтруктурныеЕдиницы", "Организации", "асВидыРемонта", "Кассы", "КассыККМ", "СпособыОплаты", "ВидыПлатежныхКарт", "ВидыЦен", "ВидыЦен");
КонецФункции

&НаСервере
Функция ЛокальныеВариантыНастроек()
    Результат = Новый Структура;
    Для Каждого Пара Из КаталогиНастроек() Цикл
        Список = Новый Массив;
        Список.Добавить(Новый Структура("id,name", "", "Выберите…"));
        ТекстЗапроса = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник." + Пара.Значение + " ГДЕ НЕ ПометкаУдаления";
        Если Пара.Ключ = "repair" Тогда ТекстЗапроса = ТекстЗапроса + " И ТипРемонта = ЗНАЧЕНИЕ(Перечисление.асТипыРемонта.Платный)"; КонецЕсли;
        Если Пара.Ключ = "workshop" Тогда ТекстЗапроса = ТекстЗапроса + " И ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.асЦех)"; КонецЕсли;
        Запрос = Новый Запрос(ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Наименование");
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл Список.Добавить(Новый Структура("id,name", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование)); КонецЦикла;
        Результат.Вставить(Пара.Ключ, Список);
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Процедура ПроверитьНастройки(Настройки)
    Для Каждого Пара Из КаталогиНастроек() Цикл
        Если Настройки.Свойство(Пара.Ключ) И Не ПустаяСтрока(Настройки[Пара.Ключ]) Тогда
            Ссылка = Справочники[Пара.Значение].ПолучитьСсылку(Новый УникальныйИдентификатор(Настройки[Пара.Ключ]));
            Если Не ЕстьОбъект("Справочник." + Пара.Значение, Ссылка) Тогда ВызватьИсключение "Реквизит настроек не найден в этой базе: " + Пара.Ключ; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СсылкаНастройки(Настройки, Ключ, Обязательно = Истина)
    ИмяКаталога = КаталогиНастроек()[Ключ];
    Если Не Настройки.Свойство(Ключ) Или ПустаяСтрока(Настройки[Ключ]) Тогда
        Если Обязательно Тогда ВызватьИсключение "Откройте настройки точки и заполните: " + Ключ; КонецЕсли;
        Возврат Справочники[ИмяКаталога].ПустаяСсылка();
    КонецЕсли;
    Возврат Справочники[ИмяКаталога].ПолучитьСсылку(Новый УникальныйИдентификатор(Настройки[Ключ]));
КонецФункции

&НаСервере
Функция ЕстьОбъект(ИмяМетаданных, Ссылка)
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ " + ИмяМетаданных + " ГДЕ Ссылка = &Ссылка");
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

&НаСервере
Функция СсылкаЗаказа(Запись, ЗаказСервера = Неопределено)
    Если ЗаказСервера <> Неопределено И ЗаказСервера.Свойство("order_ref") И ЗаказСервера.order_ref <> Неопределено Тогда
        Возврат Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗаказСервера.order_ref));
    КонецЕсли;
    // Одна запись сайта — одна ссылка документа в этой базе. Повтор сохранения
    // после потери HTTP-ответа не создаёт второй заказ-наряд.
    Ссылка = Документы.асЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.id));
    Если ЕстьОбъект("Документ.асЗаказНаряд", Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    // Совместимость с прежним обменом: сначала найдём уже созданный заказ по заявке.
    Заявка = Документы.асЗаявкаНаРемонт.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.id));
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.асЗаказНаряд ГДЕ ДокументОснование = &Заявка И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Заявка", Заявка);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Первая = Выборка.Ссылка;
        Если Выборка.Следующий() Тогда ВызватьИсключение "По записи найдено несколько заказов. Устраните неоднозначность в 1С."; КонецЕсли;
        Возврат Первая;
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

&НаСервере
Функция КонтрагентПоЗаписи(Запись)
    Телефон = СтрЗаменить(Запись.client_phone, "+", "");
    Найден = ТелефонияСервер.ПолучитьАбонентаПоНомеруТелефона(Телефон, Истина, Ложь, Ложь);
    Если ТипЗнч(Найден) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Найден) Тогда Возврат Найден; КонецЕсли;
    Элемент = Справочники.Контрагенты.СоздатьЭлемент();
    Данные = Новый Структура("Наименование,НаименованиеПолное,ВидКонтрагента,Покупатель,НомерТелефона", Запись.client_name, Запись.client_name, Перечисления.ВидыКонтрагентов.ФизическоеЛицо, Истина, Запись.client_phone);
    Элемент.Заполнить(Данные);
    Элемент.Комментарий = "Создан рабочим местом Мой Сервис";
    Элемент.Записать();
    Возврат Элемент.Ссылка;
КонецФункции

&НаСервере
Функция АвтомобильПоЗаписи(Запись, Контрагент)
    Если Запись.car <> Неопределено Тогда
        Ссылка = Справочники.асАвтомобили.ПолучитьСсылку(Новый УникальныйИдентификатор(Запись.car));
        Если ЕстьОбъект("Справочник.асАвтомобили", Ссылка) Тогда
            Авто = Ссылка.ПолучитьОбъект();
        Иначе
            Совпадение = НайтиАвтомобильПоРеквизитам(Запись, Контрагент);
            Если ЗначениеЗаполнено(Совпадение) Тогда
                Авто = Совпадение.ПолучитьОбъект();
            Иначе
                Авто = Справочники.асАвтомобили.СоздатьЭлемент();
                Авто.УстановитьСсылкуНового(Ссылка);
            КонецЕсли;
        КонецЕсли;
    Иначе
        Авто = Справочники.асАвтомобили.СоздатьЭлемент();
    КонецЕсли;
    Авто.Наименование = Лев(Запись.car_model, 100);
    Авто.VIN = Запись.car_vin;
    Авто.Записать();
    Виды = Перечисления.асДополнительнаяИнформацияАвтомобилей;
    Справочники.асАвтомобили.ЗаписатьЗначенияДополнительнойИнформацииАвтомобиля(Авто.Ссылка, Запись.car_plate, Виды.ГосНомер);
    Справочники.асАвтомобили.ЗаписатьЗначенияДополнительнойИнформацииАвтомобиля(Авто.Ссылка, Контрагент, Виды.Хозяин);
    Если Запись.car_mileage <> Неопределено Тогда Справочники.асАвтомобили.ЗаписатьЗначенияДополнительнойИнформацииАвтомобиля(Авто.Ссылка, ЧислоИзJSON(Запись.car_mileage), Виды.Пробег); КонецЕсли;
    Возврат Авто.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиАвтомобильПоРеквизитам(Запись, Контрагент)
    Если Не ПустаяСтрока(Запись.car_vin) Тогда
        Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.асАвтомобили ГДЕ VIN = &VIN И НЕ ПометкаУдаления");
        Запрос.УстановитьПараметр("VIN", Запись.car_vin);
    ИначеЕсли Не ПустаяСтрока(Запись.car_plate) Тогда
        Запрос = Новый Запрос("ВЫБРАТЬ Номер.Автомобиль КАК Ссылка ИЗ РегистрСведений.асАвтомобили КАК Номер ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.асАвтомобили КАК Владелец ПО Номер.Автомобиль = Владелец.Автомобиль ГДЕ Номер.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.асДополнительнаяИнформацияАвтомобилей.ГосНомер) И Номер.Значение = &Номер И Владелец.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.асДополнительнаяИнформацияАвтомобилей.Хозяин) И Владелец.Значение = &Владелец И НЕ Номер.Автомобиль.ПометкаУдаления");
        Запрос.УстановитьПараметр("Номер", Запись.car_plate);
        Запрос.УстановитьПараметр("Владелец", Контрагент);
    Иначе Возврат Справочники.асАвтомобили.ПустаяСсылка(); КонецЕсли;
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда Возврат Справочники.асАвтомобили.ПустаяСсылка(); КонецЕсли;
    Ссылка = Выборка.Ссылка;
    Если Выборка.Следующий() Тогда ВызватьИсключение "В 1С найдено несколько машин с такими реквизитами. Уточните VIN и устраните дубли."; КонецЕсли;
    Возврат Ссылка;
КонецФункции

&НаСервере
Функция ДокументДляПодбора(Таб, Настройки)
    Ссылка = СсылкаЗаказа(Таб.booking, Таб.order);
    Если ЕстьОбъект("Документ.асЗаказНаряд", Ссылка) Тогда Возврат Ссылка.ПолучитьОбъект(); КонецЕсли;
    Документ = Документы.асЗаказНаряд.СоздатьДокумент();
    Документ.Дата = ТекущаяДатаСеанса();
    Документ.Заполнить(Неопределено);
    Документ.СтруктурнаяЕдиница = СсылкаНастройки(Настройки, "workshop");
    Документ.Организация = СсылкаНастройки(Настройки, "organization");
    Документ.ВидРемонта = СсылкаНастройки(Настройки, "repair");
    Если Настройки.Свойство("price") И Не ПустаяСтрока(Настройки.price) Тогда Документ.ВидЦен = СсылкаНастройки(Настройки, "price"); КонецЕсли;
    Если Настройки.Свойство("workprice") И Не ПустаяСтрока(Настройки.workprice) Тогда Документ.ВидЦенРабот = СсылкаНастройки(Настройки, "workprice"); КонецЕсли;
    Возврат Документ;
КонецФункции

&НаСервере
Функция НайтиНоменклатуру(ДанныеДействия)
    Настройки = Настройка("Точка_" + ПроверитьUUID(ДанныеДействия.point), Новый Структура);
    Документ = ДокументДляПодбора(ДанныеДействия.tab, Настройки);
    Типы = Новый Массив;
    Если ДанныеДействия.kind = "work" Тогда Типы.Добавить(Перечисления.ТипыНоменклатуры.Работа); Типы.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
    Иначе Типы.Добавить(Перечисления.ТипыНоменклатуры.Запас); КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 50 Ссылка, Наименование, ЕдиницаИзмерения ИЗ Справочник.Номенклатура ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа И НЕ ЭтоНабор И ТипНоменклатуры В (&Типы) И (Наименование ПОДОБНО &Поиск ИЛИ Артикул ПОДОБНО &Поиск) УПОРЯДОЧИТЬ ПО Наименование");
    Запрос.УстановитьПараметр("Типы", Типы);
    Запрос.УстановитьПараметр("Поиск", "%" + СокрЛП(ДанныеДействия.query) + "%");
    Результат = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Цена = ЦенаНоменклатуры(Документ, Выборка.Ссылка, ДанныеДействия.kind);
        Результат.Добавить(Новый Структура("ref,name,kind,unit,price", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование, ДанныеДействия.kind, Строка(Выборка.ЕдиницаИзмерения), Цена));
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервере
Функция ЦенаНоменклатуры(Документ, Номенклатура, Вид)
    Если Вид = "work" Тогда
        Цены = Справочники.Номенклатура.ПолучитьЦенуАвтоработы(Номенклатура, Документ.Автомобиль, Документ.Договор, Документ.СтруктурнаяЕдиница, Документ.ВидРемонта, Документ.ВидЦенРабот, Документ.Дата, Документ.ВалютаДокумента, Документ.Курс, Документ.Кратность);
        Возврат Цены.Цена;
    КонецЕсли;
    ДанныеДействия = Новый Структура("Номенклатура,ДатаОбработки,ВидЦен,ВалютаДокумента,Коэффициент,Характеристика,СуммаВключаетНДС", Номенклатура, Документ.Дата, Документ.ВидЦен, Документ.ВалютаДокумента, 1, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Документ.СуммаВключаетНДС);
    Возврат ЦенообразованиеСервер.ПолучитьЦенуНоменклатурыПоВидуЦен(ДанныеДействия);
КонецФункции

&НаСервере
Процедура СохранитьЗаказИОтправить(Таб, Точка)
    Точка = Таб.booking.service_point;
    СохранитьПравкуЗаписи(Таб);
    Настройки = Настройка("Точка_" + ПроверитьUUID(Точка), Новый Структура);
    Ссылка = СсылкаЗаказа(Таб.booking, Таб.order);
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("Документ.асЗаказНаряд");
        Элемент.УстановитьЗначение("Ссылка", Ссылка);
        Блокировка.Заблокировать();
        НовыйДокумент = Не ЕстьОбъект("Документ.асЗаказНаряд", Ссылка);
        Если НовыйДокумент Тогда
            Документ = Документы.асЗаказНаряд.СоздатьДокумент();
            Документ.Дата = ТекущаяДатаСеанса();
            Документ.Заполнить(Неопределено);
            Документ.УстановитьСсылкуНового(Ссылка);
        Иначе
            Документ = Ссылка.ПолучитьОбъект();
            Если Документ.Проведен Или Документ.НомерЧекаККМ <> 0 Тогда ВызватьИсключение "Заказ уже проведён или фискализирован. Изменение запрещено."; КонецЕсли;
            Если Таб.Свойство("native_version") И Таб.native_version <> ЗначениеВСтрокуВнутр(Документ.ВерсияДанных) Тогда ВызватьИсключение "Заказ изменён другим пользователем 1С. Перечитайте его."; КонецЕсли;
        КонецЕсли;
        Контрагент = КонтрагентПоЗаписи(Таб.booking);
        Если НовыйДокумент Тогда
            Заполнение = Новый Структура("Контрагент,Заказчик,Организация,СтруктурнаяЕдиница,ВидРемонта", Контрагент, Контрагент, СсылкаНастройки(Настройки, "organization"), СсылкаНастройки(Настройки, "workshop"), СсылкаНастройки(Настройки, "repair"));
            Документ.Заполнить(Заполнение);
        КонецЕсли;
        Документ.Контрагент = Контрагент;
        Документ.Заказчик = Контрагент;
        Документ.Телефон = Таб.booking.client_phone;
        Документ.Автомобиль = АвтомобильПоЗаписи(Таб.booking, Контрагент);
        Документ.Пробег = ?(Таб.booking.car_mileage = Неопределено, 0, ЧислоИзJSON(Таб.booking.car_mileage));
        Документ.СтруктурнаяЕдиница = СсылкаНастройки(Настройки, "workshop");
        Документ.Организация = СсылкаНастройки(Настройки, "organization");
        Документ.ВидРемонта = СсылкаНастройки(Настройки, "repair");
        Если Настройки.Свойство("price") И Не ПустаяСтрока(Настройки.price) Тогда Документ.ВидЦен = СсылкаНастройки(Настройки, "price"); КонецЕсли;
        Если Настройки.Свойство("workprice") И Не ПустаяСтрока(Настройки.workprice) Тогда Документ.ВидЦенРабот = СсылкаНастройки(Настройки, "workprice"); КонецЕсли;
        Если Не ЗначениеЗаполнено(Документ.Договор) Тогда
            Если Не Контрагент.ВестиРасчетыПоДоговорам Тогда Документ.Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);
            Иначе
                ВидыДоговоров = Новый СписокЗначений;
                ВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.СПокупателем);
                Документ.Договор = Справочники.ДоговорыКонтрагентов.ПоКонтрагентуПоОрганизации(Контрагент, Документ.Организация, ВидыДоговоров);
            КонецЕсли;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Документ.ВалютаДокумента) Тогда Документ.ВалютаДокумента = УправлениеНебольшойФирмойПовтИсп.ПолучитьНациональнуюВалюту(); КонецЕсли;
        Если Документ.Курс = 0 Тогда Документ.Курс = 1; КонецЕсли;
        Если Документ.Кратность = 0 Тогда Документ.Кратность = 1; КонецЕсли;
        Документ.НалогообложениеНДС = НалогиУНФ.НалогообложениеНДС(Документ.Организация, , Документ.Дата);
        Документ.СпециальныйНалоговыйРежим = НалогиУНФ.СпециальныйНалоговыйРежим(Документ.Организация, Документ.СтруктурнаяЕдиница, Документ.Дата);
        Если Документ.ВидРемонта.ТипРемонта <> Перечисления.асТипыРемонта.Платный Тогда ВызватьИсключение "В настройках нужен платный вид ремонта."; КонецЕсли;
        Документ.ПричинаОбращения = Таб.booking.service_title + Символы.ПС + Таб.booking.client_comment;
        МестноеВремя = Таб.booking.local_time;
        Если СтрДлина(МестноеВремя) = 16 Тогда
            Документ.ДатаНачала = Дата(
                Число(Сред(МестноеВремя, 7, 4)),
                Число(Сред(МестноеВремя, 4, 2)),
                Число(Лев(МестноеВремя, 2)),
                Число(Сред(МестноеВремя, 12, 2)),
                Число(Сред(МестноеВремя, 15, 2)),
                0);
        КонецЕсли;
        Документ.Рекомендации = Таб.recommendations;
        ЗаполнитьСтрокиЗаказа(Документ, Таб.lines);
        ПересчитатьДокумент(Документ);
        Документ.Записать(РежимЗаписиДокумента.Запись);
        ЗафиксироватьТранзакцию();
    Исключение ОтменитьТранзакцию(); ВызватьИсключение; КонецПопытки;
    Таб.Вставить("native_version", ЗначениеВСтрокуВнутр(Документ.ВерсияДанных));
    // Передаём именно записанные данные, а не непроверенный HTML-черновик.
    Строки = СтрокиДокумента(Документ);
    Ревизия = ?(Таб.order = Неопределено, 1, Таб.order.revision);
    Тело = Новый Структура("revision,order_ref,order_number,lines,recommendations", Ревизия, Строка(Ссылка.УникальныйИдентификатор()), Документ.Номер, Строки, Документ.Рекомендации);
    Ответ = API("/api/v1/onec/workplace/bookings/" + ПроверитьUUID(Таб.booking.id) + "/order/", Тело);
    Таб.order = Ответ.order;
    Таб.lines = Строки;
    Таб.dirty = Ложь;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиЗаказа(Документ, Строки)
    Если Строки.Количество() = 0 Тогда ВызватьИсключение "Добавьте работы или материалы."; КонецЕсли;
    Для Каждого ИмяТЧ Из СтрРазделить("Работы,Запасы", ",") Цикл
        Оставить = Новый Массив;
        Для Каждого ДанныеСтроки Из Строки Цикл
            Если ?(ДанныеСтроки.kind = "work", "Работы", "Запасы") <> ИмяТЧ Тогда Продолжить; КонецЕсли;
            Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеСтроки.ref));
            Если Не ЕстьОбъект("Справочник.Номенклатура", Номенклатура) Тогда ВызватьИсключение "Номенклатура не найдена в 1С: " + ДанныеСтроки.name; КонецЕсли;
            Если Номенклатура.ПометкаУдаления Или Номенклатура.ЭтоГруппа Или Номенклатура.ЭтоНабор Тогда ВызватьИсключение "Выберите действующую номенклатуру, а не группу или набор."; КонецЕсли;
            Если ИмяТЧ = "Запасы" И Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Запас Тогда ВызватьИсключение "В материалы можно добавить только товар."; КонецЕсли;
            Если ИмяТЧ = "Работы" И Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Работа И Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга Тогда ВызватьИсключение "Выберите работу или услугу."; КонецЕсли;
            ИмяИдентификатора = ?(ИмяТЧ = "Работы", "ИдентификаторРаботы", "ИдентификаторСтроки");
            СтрокаДок = Неопределено;
            Если ДанныеСтроки.Свойство("line_id") И ДанныеСтроки.line_id <> Неопределено Тогда СтрокаДок = Документ[ИмяТЧ].Найти(ИдентификаторСтрокиЗаказа(ДанныеСтроки.line_id, ИмяТЧ), ИмяИдентификатора); КонецЕсли;
            Если СтрокаДок = Неопределено Тогда
                СтрокаДок = Документ[ИмяТЧ].Добавить();
                СтрокаДок[ИмяИдентификатора] = ИдентификаторСтрокиЗаказа(Строка(Новый УникальныйИдентификатор), ИмяТЧ);
                Если ИмяТЧ = "Запасы" Тогда СтрокаДок.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения; Иначе СтрокаДок.Коэффициент = 1; КонецЕсли;
            КонецЕсли;
            СтрокаДок.Номенклатура = Номенклатура;
            СтрокаДок.Количество = ЧислоИзJSON(ДанныеСтроки.quantity);
            СтрокаДок.Цена = ЧислоИзJSON(ДанныеСтроки.price);
            Если СтрокаДок.Количество <= 0 Или СтрокаДок.Цена < 0 Тогда ВызватьИсключение "Проверьте количество и цену."; КонецЕсли;
            ПараметрыНДС = Новый Структура("Номенклатура,ДатаОбработки,Организация,НалогообложениеНДС", Номенклатура, Документ.Дата, Документ.Организация, Документ.НалогообложениеНДС);
            НДС = НоменклатураВДокументахСервер.ДанныеНДССтрокиНоменклатуры(ПараметрыНДС);
            СтрокаДок.СтавкаНДС = НДС.СтавкаНДС;
            Оставить.Добавить(СтрокаДок);
        КонецЦикла;
        Индекс = Документ[ИмяТЧ].Количество() - 1;
        Пока Индекс >= 0 Цикл
            Если Оставить.Найти(Документ[ИмяТЧ][Индекс]) = Неопределено Тогда Документ[ИмяТЧ].Удалить(Индекс); КонецЕсли;
            Индекс = Индекс - 1;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторСтрокиЗаказа(Ид, ИмяТЧ)
    // В работах это UUID, в запасах — определяемый тип УникальныйИдентификаторИС (строка 36).
    Если ИмяТЧ = "Работы" Тогда Возврат Новый УникальныйИдентификатор(Ид); КонецЕсли;
    Возврат Строка(Новый УникальныйИдентификатор(Ид));
КонецФункции

&НаСервереБезКонтекста
Процедура ПересчитатьДокумент(Документ)
    Для Каждого ИмяТЧ Из СтрРазделить("Работы,Запасы", ",") Цикл
        Для Каждого СтрокаДок Из Документ[ИмяТЧ] Цикл
            СтрокаДок.СуммаСкидкиНаценки = Окр(СтрокаДок.Количество * СтрокаДок.Цена * СтрокаДок.ПроцентСкидкиНаценки / 100, 2);
            СтрокаДок.Сумма = Окр(СтрокаДок.Количество * СтрокаДок.Цена, 2) - СтрокаДок.СуммаСкидкиНаценки - СтрокаДок.СуммаАвтоматическойСкидки - СтрокаДок.СуммаСкидкиОплатыБонусом;
            Материалы = ?(ИмяТЧ = "Работы", СтрокаДок.СуммаМатериалов, 0);
            БазаНДС = СтрокаДок.Сумма + Материалы;
            ПроцентНДС = СтрокаДок.СтавкаНДС.Ставка;
            СтрокаДок.СуммаНДС = ?(Документ.СуммаВключаетНДС, Окр(БазаНДС * ПроцентНДС / (100 + ПроцентНДС), 2), Окр(БазаНДС * ПроцентНДС / 100, 2));
            СтрокаДок.Всего = БазаНДС + ?(Документ.СуммаВключаетНДС, 0, СтрокаДок.СуммаНДС);
        КонецЦикла;
    КонецЦикла;
    Документ.СуммаРаботДокумента = Документ.Работы.Итог("Всего");
    Документ.СуммаНоменклатурыДокумента = Документ.Запасы.Итог("Всего");
    Документ.СуммаНДСДокумента = Документ.Работы.Итог("СуммаНДС") + Документ.Запасы.Итог("СуммаНДС");
    Документ.СуммаДокумента = Документ.СуммаРаботДокумента + Документ.СуммаНоменклатурыДокумента;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокиДокумента(Документ)
    Строки = Новый Массив;
    Для Каждого ИмяТЧ Из СтрРазделить("Работы,Запасы", ",") Цикл
        Для Каждого СтрокаДок Из Документ[ИмяТЧ] Цикл
            ИмяИдентификатора = ?(ИмяТЧ = "Работы", "ИдентификаторРаботы", "ИдентификаторСтроки");
            Единица = ?(ИмяТЧ = "Работы", "усл.", Строка(СтрокаДок.ЕдиницаИзмерения));
            Строки.Добавить(Новый Структура("ref,line_id,name,kind,unit,quantity,price,amount", Строка(СтрокаДок.Номенклатура.УникальныйИдентификатор()), Строка(СтрокаДок[ИмяИдентификатора]), Строка(СтрокаДок.Номенклатура), ?(ИмяТЧ = "Работы", "work", "material"), Единица, СтрокаДок.Количество, СтрокаДок.Цена, СтрокаДок.Всего));
        КонецЦикла;
    КонецЦикла;
    Возврат Строки;
КонецФункции

&НаСервере
Процедура ДополнитьЛокальнымиДанными(Таб)
    Ссылка = СсылкаЗаказа(Таб.booking, Таб.order);
    Если Не ЕстьОбъект("Документ.асЗаказНаряд", Ссылка) Тогда Возврат; КонецЕсли;
    Документ = Ссылка.ПолучитьОбъект();
    Таб.Вставить("native_version", ЗначениеВСтрокуВнутр(Документ.ВерсияДанных));
    Таб.Вставить("readonly", Документ.Проведен Или Документ.НомерЧекаККМ <> 0);
    Если Таб.order = Неопределено Тогда
        Таб.lines = СтрокиДокумента(Документ);
        Таб.recommendations = Документ.Рекомендации;
    КонецЕсли;
    Если ЗначениеЗаполнено(Документ.Автомобиль) И ПустаяСтрока(Таб.booking.car_vin) Тогда Таб.booking.car_vin = Документ.Автомобиль.VIN; КонецЕсли;
КонецПроцедуры
