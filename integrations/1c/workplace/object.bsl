Функция СведенияОВнешнейОбработке() Экспорт
    Сведения = Новый Структура;
    Сведения.Вставить("Вид", "ДополнительнаяОбработка");
    Сведения.Вставить("Наименование", "Мой Сервис — мастер (прямое подключение)");
    Сведения.Вставить("Версия", "2.0.2");
    Сведения.Вставить("БезопасныйРежим", Ложь);
    Сведения.Вставить("Информация", "Рабочее место для Автосервис 3.0.14.159, платформа 8.5.1.1529. Прямой API сервера, запись заказ-наряда без проведения, подключаемое оборудование 1С.");
    Сведения.Вставить("Назначение", Новый Массив);
    Команды = Новый ТаблицаЗначений;
    Для Каждого Имя Из СтрРазделить("Представление,Идентификатор,Использование,ПоказыватьОповещение,Модификатор", ",") Цикл Команды.Колонки.Добавить(Имя); КонецЦикла;
    Команда = Команды.Добавить();
    Команда.Представление = "Рабочее место мастера";
    Команда.Идентификатор = "Открыть";
    Команда.Использование = "ОткрытиеФормы";
    Команда.ПоказыватьОповещение = Ложь;
    Команда.Модификатор = "";
    Сведения.Вставить("Команды", Команды);
    Возврат Сведения;
КонецФункции
