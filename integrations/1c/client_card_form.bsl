// Внешняя обработка «Мой Сервис: клиент по номеру» — модуль формы.
//
// Та же карточка клиента, что в панели мастера на сайте: вход сотрудника
// на вкладке «Вход», на вкладке «Клиент» — номер в любой записи (8 900…,
// +7 900… или последние 4–9 цифр) и всё о клиенте: машины, баллы, кто
// пригласил, ближайшие и прошлые записи с ценами, звонки.
//
// Форма собирается кодом в ПриСозданииНаСервере: в Конфигураторе нужна
// только пустая форма с этим модулем, ничего не надо раскладывать руками.
// Поэтому реквизиты читаются как ЭтотОбъект["Имя"] — при компиляции модуля
// их ещё нет.
//
// Данные — из API сайта с правами вошедшего сотрудника: мастер видит записи
// и звонки только своих точек, как на сайте. Пароль нигде не сохраняется:
// после входа остаются только токены сессии в самой форме. Адрес сайта и
// телефон для входа запоминаются в настройках пользователя 1С.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДобавитьРеквизиты();
	ПостроитьФорму();

	ЭтотОбъект["АдресСервера"] = ЗагрузитьНастройку("АдресСервера", "https://moi-servis.ru");
	ЭтотОбъект["Логин"] = ЗагрузитьНастройку("Логин", "");
	ЭтотОбъект["КарточкаHTML"] = СтраницаHTML(Подсказка());

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Войти(Команда)

	Элементы.ОшибкаВхода.Заголовок = "";
	Итог = ВойтиНаСервере(ЭтотОбъект["АдресСервера"], ЭтотОбъект["Логин"], ЭтотОбъект["Пароль"]);
	ЭтотОбъект["Пароль"] = "";

	Если Не Итог.Успех Тогда
		Элементы.ОшибкаВхода.Заголовок = Итог.Ошибка;
		Возврат;
	КонецЕсли;

	ЭтотОбъект["Доступ"] = Итог.Доступ;
	ЭтотОбъект["Обновление"] = Итог.Обновление;
	Элементы.СтраницаКлиент.Заголовок = "Клиент · " + Итог.Имя;
	Элементы.СтраницаКлиент.Видимость = Истина;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКлиент;
	ТекущийЭлемент = Элементы.НомерКлиента;

КонецПроцедуры

&НаКлиенте
Процедура НайтиКлиента(Команда)

	ПоказатьКлиента(ЭтотОбъект["НомерКлиента"], "");

КонецПроцедуры

&НаКлиенте
Процедура Выйти(Команда)

	ЗавершитьСеанс("");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура НомерКлиентаПриИзменении(Элемент)

	ПоказатьКлиента(ЭтотОбъект["НомерКлиента"], "");

КонецПроцедуры

// Ссылки в карточке — только «открыть клиента» из списка найденных.
// Остальным переходам внутри поля не даём случиться: поле — не браузер.
&НаКлиенте
Процедура КарточкаHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = "";
	Попытка
		Ссылка = Строка(ДанныеСобытия.Href);
	Исключение
		Ссылка = "";
	КонецПопытки;

	Если ПустаяСтрока(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Позиция = СтрНайти(Ссылка, "client=");
	Если Позиция > 0 Тогда
		ПоказатьКлиента("", Сред(Ссылка, Позиция + 7, 36));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьКлиента(Номер, ИдКлиента)

	Итог = НайтиНаСервере(ЭтотОбъект["АдресСервера"], ЭтотОбъект["Доступ"],
		ЭтотОбъект["Обновление"], Номер, ИдКлиента);

	Если Итог.НужноВойти Тогда
		ЗавершитьСеанс("Сессия истекла — войдите снова.");
		Возврат;
	КонецЕсли;

	ЭтотОбъект["Доступ"] = Итог.Доступ;
	ЭтотОбъект["Обновление"] = Итог.Обновление;
	ЭтотОбъект["КарточкаHTML"] = Итог.Html;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьСеанс(Причина)

	ЭтотОбъект["Доступ"] = "";
	ЭтотОбъект["Обновление"] = "";
	ЭтотОбъект["КарточкаHTML"] = СтраницаHTML(Подсказка());
	Элементы.ОшибкаВхода.Заголовок = Причина;
	Элементы.СтраницаКлиент.Видимость = Ложь;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаВход;
	ТекущийЭлемент = Элементы.Пароль;

КонецПроцедуры

#Область Форма

&НаСервере
Процедура ДобавитьРеквизиты()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	Добавляемые = Новый Массив;
	Имена = "АдресСервера,Логин,Пароль,Доступ,Обновление,НомерКлиента,КарточкаHTML";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Добавляемые.Добавить(Новый РеквизитФормы(Имя, ТипСтрока));
	КонецЦикла;
	ИзменитьРеквизиты(Добавляемые);

КонецПроцедуры

&НаСервере
Процедура ПостроитьФорму()

	Заголовок = "Мой Сервис: клиент по номеру";

	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"));
	Страницы.Вид = ВидГруппыФормы.Страницы;
	Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;

	// Вкладка «Вход»: адрес сайта, телефон и пароль сотрудника — как в панели.
	Вход = Элементы.Добавить("СтраницаВход", Тип("ГруппаФормы"), Страницы);
	Вход.Вид = ВидГруппыФормы.Страница;
	Вход.Заголовок = "Вход";
	ДобавитьПоле("АдресСервера", "Адрес сайта", Вход);
	ДобавитьПоле("Логин", "Телефон сотрудника", Вход);
	ЭлементПоля = ДобавитьПоле("Пароль", "Пароль", Вход);
	ЭлементПоля.РежимПароля = Истина;
	Кнопка = ДобавитьКнопку("Войти", "Войти", Вход);
	Кнопка.КнопкаПоУмолчанию = Истина;
	Надпись = Элементы.Добавить("ОшибкаВхода", Тип("ДекорацияФормы"), Вход);
	Надпись.Вид = ВидДекорацииФормы.Надпись;
	Надпись.Заголовок = "";
	Надпись.ЦветТекста = WebЦвета.Красный;

	// Вкладка «Клиент» — после входа: номер и карточка во всю высоту.
	Клиент = Элементы.Добавить("СтраницаКлиент", Тип("ГруппаФормы"), Страницы);
	Клиент.Вид = ВидГруппыФормы.Страница;
	Клиент.Заголовок = "Клиент";
	Клиент.Видимость = Ложь;

	Поиск = Элементы.Добавить("СтрокаПоиска", Тип("ГруппаФормы"), Клиент);
	Поиск.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Поиск.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Поиск.ОтображатьЗаголовок = Ложь;
	ЭлементПоля = ДобавитьПоле("НомерКлиента", "Номер клиента", Поиск);
	ЭлементПоля.ПодсказкаВвода = "+7 900 123-45-67 или 4567";
	ЭлементПоля.УстановитьДействие("ПриИзменении", "НомерКлиентаПриИзменении");
	ДобавитьКнопку("НайтиКлиента", "Найти", Поиск);
	ДобавитьКнопку("Выйти", "Выйти", Поиск);

	ЭлементПоля = Элементы.Добавить("КарточкаHTML", Тип("ПолеФормы"), Клиент);
	ЭлементПоля.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	ЭлементПоля.ПутьКДанным = "КарточкаHTML";
	ЭлементПоля.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементПоля.РастягиватьПоГоризонтали = Истина;
	ЭлементПоля.РастягиватьПоВертикали = Истина;
	ЭлементПоля.УстановитьДействие("ПриНажатии", "КарточкаHTMLПриНажатии");

КонецПроцедуры

&НаСервере
Функция ДобавитьПоле(Имя, Подпись, Родитель)

	ЭлементПоля = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	ЭлементПоля.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементПоля.ПутьКДанным = Имя;
	ЭлементПоля.Заголовок = Подпись;
	Возврат ЭлементПоля;

КонецФункции

&НаСервере
Функция ДобавитьКнопку(Имя, Подпись, Родитель)

	Команда = Команды.Добавить(Имя);
	Команда.Действие = Имя;
	Команда.Заголовок = Подпись;
	Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
	Возврат Кнопка;

КонецФункции

#КонецОбласти

#Область Сайт

&НаСервереБезКонтекста
Функция ВойтиНаСервере(Адрес, Логин, Пароль)

	Итог = Новый Структура("Успех,Ошибка,Доступ,Обновление,Имя", Ложь, "", "", "", "");
	Если ПустаяСтрока(Логин) Или ПустаяСтрока(Пароль) Тогда
		Итог.Ошибка = "Введите телефон и пароль сотрудника.";
		Возврат Итог;
	КонецЕсли;

	Тело = Новый Структура("phone,password", СокрЛП(Логин), Пароль);
	Ответ = Вызвать(Адрес, "/api/v1/auth/staff/login/", Тело, "");
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибка = ТекстОшибки(Ответ);
		Возврат Итог;
	КонецЕсли;

	Роль = ПолеJSON(Ответ.Данные, "user", "role");
	Если Роль <> "master" И Роль <> "admin" Тогда
		Итог.Ошибка = "Вход только для сотрудников сервиса.";
		Возврат Итог;
	КонецЕсли;

	Итог.Успех = Истина;
	Итог.Доступ = ПолеJSON(Ответ.Данные, "access");
	Итог.Обновление = ПолеJSON(Ответ.Данные, "refresh");
	Итог.Имя = ПолеJSON(Ответ.Данные, "user", "full_name");
	СохранитьНастройку("АдресСервера", СокрЛП(Адрес));
	СохранитьНастройку("Логин", СокрЛП(Логин));
	Возврат Итог;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиНаСервере(Адрес, Доступ, Обновление, Номер, ИдКлиента)

	Итог = Новый Структура("Html,Доступ,Обновление,НужноВойти", "", Доступ, Обновление, Ложь);
	Ид = ИдКлиента;

	Если ПустаяСтрока(Ид) Тогда
		Если ПустаяСтрока(Номер) Тогда
			Итог.Html = СтраницаHTML(Подсказка());
			Возврат Итог;
		КонецЕсли;
		Путь = "/api/v1/master/clients/?phone="
			+ КодироватьСтроку(СокрЛП(Номер), СпособКодированияСтроки.КодировкаURL);
		Ответ = ВызватьСВходом(Адрес, Путь, Итог);
		Если Итог.НужноВойти Тогда
			Возврат Итог;
		ИначеЕсли Ответ.Код <> 200 Тогда
			Итог.Html = СтраницаHTML(Ошибка(ТекстОшибки(Ответ)));
			Возврат Итог;
		КонецЕсли;

		Найдено = Ответ.Данные;
		Если ТипЗнч(Найдено) <> Тип("Массив") Или Найдено.Количество() = 0 Тогда
			Итог.Html = СтраницаHTML("<p class=""muted"">Клиента с номером «"
				+ Экр(Номер) + "» в базе нет.</p>");
			Возврат Итог;
		ИначеЕсли Найдено.Количество() > 1 Тогда
			Итог.Html = СтраницаHTML(СписокHTML(Найдено));
			Возврат Итог;
		КонецЕсли;
		Ид = ПолеJSON(Найдено[0], "id");
	КонецЕсли;

	Ответ = ВызватьСВходом(Адрес, "/api/v1/master/clients/" + Ид + "/", Итог);
	Если Итог.НужноВойти Тогда
		Возврат Итог;
	ИначеЕсли Ответ.Код <> 200 Тогда
		Итог.Html = СтраницаHTML(Ошибка(ТекстОшибки(Ответ)));
	Иначе
		Итог.Html = СтраницаHTML(HTMLКарточки(Ответ.Данные));
	КонецЕсли;
	Возврат Итог;

КонецФункции

// GET с токеном сотрудника. Токен живёт час: на 401 обновляем его один раз
// и повторяем запрос; не вышло — сотруднику нужно войти заново.
&НаСервереБезКонтекста
Функция ВызватьСВходом(Адрес, Путь, Итог)

	Ответ = Вызвать(Адрес, Путь, Неопределено, Итог.Доступ);
	Если Ответ.Код <> 401 Тогда
		Возврат Ответ;
	КонецЕсли;

	Обновлено = Вызвать(Адрес, "/api/v1/auth/token/refresh/",
		Новый Структура("refresh", Итог.Обновление), "");
	Если Обновлено.Код <> 200 Тогда
		Итог.НужноВойти = Истина;
		Возврат Ответ;
	КонецЕсли;

	Итог.Доступ = ПолеJSON(Обновлено.Данные, "access");
	// Токен обновления одноразовый: сайт выдаёт новый вместе с доступом.
	Свежий = ПолеJSON(Обновлено.Данные, "refresh");
	Если Не ПустаяСтрока(Свежий) Тогда
		Итог.Обновление = Свежий;
	КонецЕсли;

	Ответ = Вызвать(Адрес, Путь, Неопределено, Итог.Доступ);
	Если Ответ.Код = 401 Тогда
		Итог.НужноВойти = Истина;
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Один HTTP-запрос к сайту: без тела — GET, с телом — POST в JSON.
&НаСервереБезКонтекста
Функция Вызвать(Адрес, Путь, Тело, Токен)

	Итог = Новый Структура("Код,Данные,Ошибка", 0, Неопределено, "");
	Части = РазобратьАдрес(Адрес);
	Если Части = Неопределено Тогда
		Итог.Ошибка = "Адрес сайта — вида https://moi-servis.ru";
		Возврат Итог;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Если Не ПустаяСтрока(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;

	Попытка
		Защита = ?(Части.Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
		Соединение = Новый HTTPСоединение(Части.Хост, Части.Порт, , , , 30, Защита);
		Запрос = Новый HTTPЗапрос(Части.Префикс + Путь, Заголовки);
		Если Тело = Неопределено Тогда
			Ответ = Соединение.Получить(Запрос);
		Иначе
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		КонецЕсли;
	Исключение
		Итог.Ошибка = "Нет связи с сайтом: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Итог.Код = Ответ.КодСостояния;
	Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Не ПустаяСтрока(Текст) Тогда
		Попытка
			Итог.Данные = ИзJSON(Текст);
		Исключение
			Итог.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// «https://moi-servis.ru» → хост, порт, https ли, путь-префикс.
&НаСервереБезКонтекста
Функция РазобратьАдрес(Адрес)

	Остаток = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Остаток), "https://") Тогда
		Защищенное = Истина;
		Остаток = Сред(Остаток, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Остаток), "http://") Тогда
		Защищенное = Ложь;
		Остаток = Сред(Остаток, 8);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Префикс = "";
	Слеш = СтрНайти(Остаток, "/");
	Если Слеш > 0 Тогда
		Префикс = Сред(Остаток, Слеш);
		Остаток = Лев(Остаток, Слеш - 1);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Префикс, "/") Цикл
		Префикс = Лев(Префикс, СтрДлина(Префикс) - 1);
	КонецЦикла;

	Порт = ?(Защищенное, 443, 80);
	Двоеточие = СтрНайти(Остаток, ":");
	Если Двоеточие > 0 Тогда
		Порт = Число(Сред(Остаток, Двоеточие + 1));
		Остаток = Лев(Остаток, Двоеточие - 1);
	КонецЕсли;

	Если ПустаяСтрока(Остаток) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Хост,Порт,Защищенное,Префикс", Остаток, Порт, Защищенное, Префикс);

КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибки(Ответ)

	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Ответ.Ошибка;
	КонецЕсли;
	Сообщение = ПолеJSON(Ответ.Данные, "error", "message");
	Если ПустаяСтрока(Сообщение) Тогда
		Сообщение = "Сайт ответил кодом " + Формат(Ответ.Код, "ЧГ=0");
	КонецЕсли;
	Возврат Сообщение;

КонецФункции

&НаСервереБезКонтекста
Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

&НаСервереБезКонтекста
Функция ИзJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

// Строка из ответа: Данные[Ключ] или Данные[Ключ][Ключ2]; нет — пустая.
&НаСервереБезКонтекста
Функция ПолеJSON(Данные, Ключ, Ключ2 = Неопределено)

	Значение = ОбъектJSON(Данные, Ключ);
	Если Ключ2 <> Неопределено Тогда
		Возврат ПолеJSON(Значение, Ключ2);
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Вложенный объект или список из ответа как есть; нет — Неопределено.
&НаСервереБезКонтекста
Функция ОбъектJSON(Данные, Ключ)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Данные.Получить(Ключ);

КонецФункции

&НаСервереБезКонтекста
Функция СписокJSON(Данные, Ключ)

	Значение = ОбъектJSON(Данные, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

КонецФункции

#КонецОбласти

#Область Карточка

&НаСервереБезКонтекста
Функция Подсказка()

	Возврат "<p class=""muted"">Введите номер клиента в любой записи — 8 900…, +7 900… "
		+ "или последние 4 цифры — и нажмите «Найти».</p>";

КонецФункции

&НаСервереБезКонтекста
Функция СписокHTML(Найдено)

	Строки = "";
	Для Каждого Клиент Из Найдено Цикл
		Строки = Строки + "<tr><td><a href=""#client=" + Экр(ПолеJSON(Клиент, "id")) + """>"
			+ Экр(ИмяКлиента(ПолеJSON(Клиент, "full_name"))) + "</a></td><td>" + Экр(ПолеJSON(Клиент, "phone"))
			+ "</td><td class=""muted"">" + Экр(ПолеJSON(Клиент, "car")) + "</td></tr>";
	КонецЦикла;
	Возврат "<h2>Найдено несколько клиентов — выберите</h2><table class=""rows"">"
		+ Строки + "</table>";

КонецФункции

&НаСервереБезКонтекста
Функция HTMLКарточки(Карточка)

	Клиент = ОбъектJSON(Карточка, "client");
	Html = "<h1>" + Экр(ИмяКлиента(ПолеJSON(Клиент, "full_name"))) + "</h1><p class=""muted"">"
		+ Экр(ПолеJSON(Клиент, "phone")) + " · с нами с " + Дата_(ПолеJSON(Клиент, "date_joined"), "ДЛФ=D")
		+ "</p><table class=""facts"">";

	// Машины: основная — первой и с пометкой.
	Машины = "";
	Для Каждого Машина Из СписокJSON(Карточка, "cars") Цикл
		Подпись = СтрСоединить(Непустые(ПолеJSON(Машина, "title"), ПолеJSON(Машина, "plate")), " · ");
		Если ОбъектJSON(Машина, "is_primary") = Истина Тогда
			Подпись = Подпись + " (основная)";
		КонецЕсли;
		Машины = Машины + "<div>" + Экр(Подпись) + "</div>";
	КонецЦикла;
	Html = Html + Факт("Машины", ?(ПустаяСтрока(Машины), "<span class=""muted"">В гараже нет</span>", Машины));

	// Баллы: баланс и сколько можно списать — в ближайшую запись или процентом от чека.
	Баллы = ОбъектJSON(Карточка, "points");
	Баланс = Число_(ПолеJSON(Баллы, "balance"));
	Следующая = ОбъектJSON(Баллы, "next");
	Если Баланс <= 0 Тогда
		ТекстБаллов = "Баллов нет";
	ИначеЕсли Следующая <> Неопределено Тогда
		ТекстБаллов = Сумма_(Баланс) + " баллов · в запись " + Экр(ПолеJSON(Следующая, "booking_code"))
			+ " можно списать до " + Сумма_(Число_(ПолеJSON(Следующая, "max_spend")));
	Иначе
		ТекстБаллов = Сумма_(Баланс) + " баллов · списать можно до "
			+ ПолеJSON(Баллы, "max_discount_percent") + "% чека";
	КонецЕсли;
	Html = Html + Факт("Баллы", ТекстБаллов);

	Пригласил = ОбъектJSON(Карточка, "invited_by");
	Html = Html + Факт("Пригласил", ?(Пригласил = Неопределено, "<span class=""muted"">Пришёл сам</span>",
		Экр(ПолеJSON(Пригласил, "name") + " · " + ПолеJSON(Пригласил, "phone")))) + "</table>";

	Html = Html + "<h2>Ближайшие записи</h2>" + ЗаписиHTML(СписокJSON(Карточка, "upcoming"), "Ближайших записей нет");
	Html = Html + "<h2>Прошлые записи</h2>" + ЗаписиHTML(СписокJSON(Карточка, "past"), "Раньше не приезжал");
	Html = Html + "<h2>Звонки</h2>" + ЗвонкиHTML(СписокJSON(Карточка, "calls"));
	Возврат Html;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаписиHTML(Записи, ЕслиПусто)

	Если Записи.Количество() = 0 Тогда
		Возврат "<p class=""muted"">" + ЕслиПусто + "</p>";
	КонецЕсли;

	Строки = "";
	Для Каждого Запись Из Записи Цикл
		Если ОбъектJSON(Запись, "needs_service") = Истина Тогда
			Услуга = "Подобрать услугу на месте";
		Иначе
			Услуга = ПолеJSON(Запись, "service_title");
		КонецЕсли;
		Где = СтрСоединить(Непустые(ПолеJSON(Запись, "category_title"), ПолеJSON(Запись, "service_point_name"),
			СтрСоединить(Непустые(ПолеJSON(Запись, "car_model"), ПолеJSON(Запись, "car_plate")), " ")), " · ");

		Сумма = Сумма_(Число_(ПолеJSON(Запись, "final_price"))) + " ₽";
		Баллами = Число_(ПолеJSON(Запись, "points_spent"));
		Если Баллами > 0 Тогда
			Сумма = Сумма + "<div class=""muted"">баллами " + Сумма_(Баллами) + " ₽</div>";
		КонецЕсли;
		// Баллы клиента до расчёта — как в строке смены на сайте.
		Предпросмотр = ОбъектJSON(Запись, "client_points");
		Если Предпросмотр <> Неопределено И Число_(ПолеJSON(Предпросмотр, "balance")) > 0 Тогда
			Сумма = Сумма + "<div class=""muted"">" + Сумма_(Число_(ПолеJSON(Предпросмотр, "balance")))
				+ " баллов, в чек до " + Сумма_(Число_(ПолеJSON(Предпросмотр, "max_spend"))) + "</div>";
		КонецЕсли;

		Комментарий = ПолеJSON(Запись, "client_comment");
		Отмена = ПолеJSON(Запись, "cancel_reason");
		Строки = Строки + "<tr><td class=""nowrap""><b>" + Экр(ПолеJSON(Запись, "local_time"))
			+ "</b><div class=""muted mono"">" + Экр(ПолеJSON(Запись, "code")) + "</div></td>"
			+ "<td><b>" + Экр(Услуга) + "</b><div class=""muted"">" + Экр(Где) + "</div>"
			+ ?(ПустаяСтрока(Комментарий), "", "<div>«" + Экр(Комментарий) + "»</div>")
			+ ?(ПустаяСтрока(Отмена), "", "<div class=""muted"">" + Экр(Отмена) + "</div>") + "</td>"
			+ "<td class=""num"">" + Сумма + "</td>"
			+ "<td>" + Статус(ПолеJSON(Запись, "status"), ПолеJSON(Запись, "status_display")) + "</td></tr>";
	КонецЦикла;
	Возврат "<table class=""rows"">" + Строки + "</table>";

КонецФункции

&НаСервереБезКонтекста
Функция ЗвонкиHTML(Звонки)

	Если Звонки.Количество() = 0 Тогда
		Возврат "<p class=""muted"">Звонков ещё не было</p>";
	КонецЕсли;

	Строки = "";
	Для Каждого Звонок Из Звонки Цикл
		Итог = ПолеJSON(Звонок, "outcome_display");
		Перезвонить = ПолеJSON(Звонок, "callback_at");
		Если Не ПустаяСтрока(Перезвонить) Тогда
			Итог = Итог + " на " + Дата_(Перезвонить, "ДФ='dd.MM HH:mm'");
		КонецЕсли;
		Подробно = СтрСоединить(Непустые(Дата_(ПолеJSON(Звонок, "created_at"), "ДФ='dd.MM HH:mm'"),
			ПолеJSON(Звонок, "actor"), ПолеJSON(Звонок, "booking_code"), ПолеJSON(Звонок, "note")), " · ");
		Строки = Строки + "<tr><td><b>" + Экр(Итог + " · " + ПолеJSON(Звонок, "reason_display"))
			+ "</b><div class=""muted"">" + Экр(Подробно) + "</div></td></tr>";
	КонецЦикла;
	Возврат "<table class=""rows"">" + Строки + "</table>";

КонецФункции

&НаСервереБезКонтекста
Функция Факт(Подпись, Значение)

	Возврат "<tr><th>" + Подпись + "</th><td>" + Значение + "</td></tr>";

КонецФункции

&НаСервереБезКонтекста
Функция Статус(Код, Подпись)

	Цвета = Новый Соответствие;
	Цвета.Вставить("pending", "info");
	Цвета.Вставить("in_progress", "warn");
	Цвета.Вставить("completed", "ok");
	Класс = Цвета.Получить(Код);
	Возврат "<span class=""badge " + ?(Класс = Неопределено, "danger", Класс) + """>" + Экр(Подпись) + "</span>";

КонецФункции

&НаСервереБезКонтекста
Функция Ошибка(Текст)

	Возврат "<p class=""error"">" + Экр(Текст) + "</p>";

КонецФункции

&НаСервереБезКонтекста
Функция СтраницаHTML(Тело)

	Стили = "body{font:13px 'Segoe UI',Arial,sans-serif;color:#1f2937;margin:12px;background:#fff}"
		+ "h1{font-size:20px;margin:0 0 2px}h2{font-size:15px;margin:18px 0 6px}"
		+ ".muted{color:#6b7280}.mono{font-family:Consolas,monospace}.error{color:#b91c1c}"
		+ "table{border-collapse:collapse;width:100%}"
		+ ".facts th{text-align:left;color:#6b7280;font-weight:normal;width:110px;padding:4px 8px 4px 0;vertical-align:top}"
		+ ".facts td{padding:4px 0}"
		+ ".rows td{border-top:1px solid #e5e7eb;padding:6px 8px 6px 0;vertical-align:top}"
		+ ".num{text-align:right;white-space:nowrap}.nowrap{white-space:nowrap}"
		+ ".badge{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;white-space:nowrap}"
		+ ".info{background:#e0ecff;color:#1d4ed8}.warn{background:#fef3c7;color:#92400e}"
		+ ".ok{background:#dcfce7;color:#166534}.danger{background:#fee2e2;color:#991b1b}"
		+ "a{color:#1d4ed8}";
	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8"">"
		+ "<meta http-equiv=""X-UA-Compatible"" content=""IE=edge""><style>" + Стили
		+ "</style></head><body>" + Тело + "</body></html>";

КонецФункции

// Всё, что пришло с сайта, — только через экранирование: имя клиента или
// комментарий с «<» не должны стать разметкой.
&НаСервереБезКонтекста
Функция Экр(Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат СтрЗаменить(Результат, """", "&quot;");

КонецФункции

&НаСервереБезКонтекста
Функция ИмяКлиента(ПолноеИмя)

	Возврат ?(ПустаяСтрока(ПолноеИмя), "Без имени", ПолноеИмя);

КонецФункции

&НаСервереБезКонтекста
Функция Непустые(Знач А = "", Знач Б = "", Знач В = "", Знач Г = "")

	Результат = Новый Массив;
	Для Каждого Значение Из СтрРазделить(А + Символы.ПС + Б + Символы.ПС + В + Символы.ПС + Г, Символы.ПС, Ложь) Цикл
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Деньги и баллы приходят строкой «3600.00».
&НаСервереБезКонтекста
Функция Число_(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция Сумма_(Значение)

	Возврат Формат(Цел(Значение), "ЧН=0; ЧГ=3,0");

КонецФункции

// Дата из ответа (UTC, «2026-10-19T05:00:50.36Z») → местное время.
&НаСервереБезКонтекста
Функция Дата_(Текст, ФорматСтрока)

	Если СтрДлина(Текст) < 19 Тогда
		Возврат "";
	КонецЕсли;
	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Текст, 19), "-", ""), "T", ""), ":", "");
	Попытка
		Возврат Формат(МестноеВремя(Дата(Цифры)), ФорматСтрока);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Настройки

&НаСервереБезКонтекста
Процедура СохранитьНастройку(Ключ, Значение)

	ХранилищеОбщихНастроек.Сохранить("МойСервис.КарточкаКлиента", Ключ, Значение);

КонецПроцедуры

&НаСервере
Функция ЗагрузитьНастройку(Ключ, ПоУмолчанию)

	Значение = ХранилищеОбщихНастроек.Загрузить("МойСервис.КарточкаКлиента", Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение), Значение, ПоУмолчанию);

КонецФункции

