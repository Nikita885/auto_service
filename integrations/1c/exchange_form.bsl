// Внешняя обработка «Мой Сервис: обмен записями» — модуль формы.
//
// Вкладка «Обмен»: «Обменять сейчас», автообмен, пока форма открыта, и
// журнал последних обменов. Вкладка «Настройки»: адрес сайта, ключ обмена,
// вид ремонта, цех и пост по умолчанию и свои цех и пост у каждой точки
// сайта (точки появляются в таблице сами после первого обмена).
//
// Вся работа — в модуле объекта (exchange_object.bsl): его же вызывает
// регламентное задание, когда формы нет.
//
// Форма собирается кодом в ПриСозданииНаСервере, как в обработке «клиент по
// номеру». Руками в свойствах формы, раздел «События», нужно привязать два
// обработчика: ПриСозданииНаСервере и ПриОткрытии — по имени 1С их не
// вызывает. Реквизиты поэтому читаются как ЭтотОбъект["Имя"].

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДобавитьРеквизиты();
	ПостроитьФорму();
	ЗагрузитьВФорму();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПерезапуститьАвтообмен();

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ОбменятьСейчас(Команда)

	Обменять();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	СохранитьНаСервере();
	ПоказатьПредупреждение(, ПроверитьСвязьНаСервере());

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНаСервере();
	ПерезапуститьАвтообмен();
	ПоказатьОповещениеПользователя("Настройки обмена сохранены");

КонецПроцедуры

&НаКлиенте
Процедура АвтообменПриИзменении(Элемент)

	СохранитьНаСервере();
	ПерезапуститьАвтообмен();

КонецПроцедуры

&НаКлиенте
Процедура ОбменПоТаймеру() Экспорт

	Обменять();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Обменять()

	Текст = ОбменНаСервере();
	// Свежий обмен — сверху: журнал читают, чтобы понять, что было только что.
	Журнал = Текст + Символы.ПС + Символы.ПС + ЭтотОбъект["Журнал"];
	ЭтотОбъект["Журнал"] = Лев(Журнал, 20000);

КонецПроцедуры

&НаКлиенте
Процедура ПерезапуститьАвтообмен()

	ОтключитьОбработчикОжидания("ОбменПоТаймеру");
	Если ЭтотОбъект["Автообмен"] Тогда
		Минуты = Макс(ЭтотОбъект["Интервал"], 1);
		ПодключитьОбработчикОжидания("ОбменПоТаймеру", Минуты * 60, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбменНаСервере()

	СохранитьНаСервере();
	Обработка = РеквизитФормыВЗначение("Объект");
	Итог = Обработка.ВыполнитьОбмен(Обработка.ЗагрузитьНастройки());
	ДобавитьНовыеТочки(Итог.Точки);
	Возврат Обработка.ТекстИтога(Итог);

КонецФункции

&НаСервере
Функция ПроверитьСвязьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПроверитьСвязь(Обработка.ЗагрузитьНастройки());

КонецФункции

// Точки сайта, которых ещё нет в таблице, — строкой без цеха: оператор
// увидит новую точку и сам решит, в какой цех её заявки.
&НаСервере
Процедура ДобавитьНовыеТочки(Точки)

	Таблица = ЭтотОбъект["Точки"];
	Добавлены = Ложь;
	Для Каждого Пара Из Точки Цикл
		Если ПустаяСтрока(Пара.Ключ) Или Таблица.НайтиСтроки(Новый Структура("Ид", Пара.Ключ)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Таблица.Добавить();
		Строка.Ид = Пара.Ключ;
		Строка.Название = Пара.Значение;
		Добавлены = Истина;
	КонецЦикла;
	Если Добавлены Тогда
		СохранитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьВФорму()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = Обработка.ЗагрузитьНастройки();
	Для Каждого Имя Из СтрРазделить("АдресСервера,Ключ,Цех,Пост,ВидРемонта,Автообмен,Интервал", ",") Цикл
		ЭтотОбъект[Имя] = Настройки[Имя];
	КонецЦикла;

	Таблица = ЭтотОбъект["Точки"];
	Таблица.Очистить();
	Для Каждого Точка Из Настройки.Точки Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Точка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = Обработка.НастройкиПоУмолчанию();
	Для Каждого Имя Из СтрРазделить("АдресСервера,Ключ,Цех,Пост,ВидРемонта,Автообмен,Интервал", ",") Цикл
		Настройки[Имя] = ЭтотОбъект[Имя];
	КонецЦикла;
	Настройки.АдресСервера = СокрЛП(Настройки.АдресСервера);
	Настройки.Ключ = СокрЛП(Настройки.Ключ);

	Для Каждого Строка Из ЭтотОбъект["Точки"] Цикл
		Настройки.Точки.Добавить(Новый Структура("Ид,Название,Цех,Пост",
			Строка.Ид, Строка.Название, Строка.Цех, Строка.Пост));
	КонецЦикла;
	Обработка.СохранитьНастройки(Настройки);

КонецПроцедуры

#КонецОбласти

#Область Форма

&НаСервере
Процедура ДобавитьРеквизиты()

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЦех = Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы");
	ТипПост = Новый ОписаниеТипов("СправочникСсылка.КлючевыеРесурсы");

	Добавляемые = Новый Массив;
	Для Каждого Имя Из СтрРазделить("АдресСервера,Ключ,Журнал", ",") Цикл
		Добавляемые.Добавить(Новый РеквизитФормы(Имя, ТипСтрока));
	КонецЦикла;
	Добавляемые.Добавить(Новый РеквизитФормы("Цех", ТипЦех));
	Добавляемые.Добавить(Новый РеквизитФормы("Пост", ТипПост));
	Добавляемые.Добавить(Новый РеквизитФормы("ВидРемонта",
		Новый ОписаниеТипов("СправочникСсылка.асВидыРемонта")));
	Добавляемые.Добавить(Новый РеквизитФормы("Автообмен", Новый ОписаниеТипов("Булево")));
	Добавляемые.Добавить(Новый РеквизитФормы("Интервал", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный))));

	Добавляемые.Добавить(Новый РеквизитФормы("Точки", Новый ОписаниеТипов("ТаблицаЗначений")));
	Добавляемые.Добавить(Новый РеквизитФормы("Ид", ТипСтрока, "Точки"));
	Добавляемые.Добавить(Новый РеквизитФормы("Название", ТипСтрока, "Точки"));
	Добавляемые.Добавить(Новый РеквизитФормы("Цех", ТипЦех, "Точки"));
	Добавляемые.Добавить(Новый РеквизитФормы("Пост", ТипПост, "Точки"));

	ИзменитьРеквизиты(Добавляемые);

КонецПроцедуры

&НаСервере
Процедура ПостроитьФорму()

	Заголовок = "Мой Сервис: обмен записями";

	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"));
	Страницы.Вид = ВидГруппыФормы.Страницы;
	Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;

	// «Обмен» — то, что нужно каждый день.
	Обмен = Элементы.Добавить("СтраницаОбмен", Тип("ГруппаФормы"), Страницы);
	Обмен.Вид = ВидГруппыФормы.Страница;
	Обмен.Заголовок = "Обмен";

	Кнопки = Элементы.Добавить("КнопкиОбмена", Тип("ГруппаФормы"), Обмен);
	Кнопки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Кнопки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Кнопки.ОтображатьЗаголовок = Ложь;
	Кнопка = ДобавитьКнопку("ОбменятьСейчас", "Обменять сейчас", Кнопки);
	Кнопка.КнопкаПоУмолчанию = Истина;
	Флажок = Элементы.Добавить("Автообмен", Тип("ПолеФормы"), Кнопки);
	Флажок.Вид = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = "Автообмен";
	Флажок.Заголовок = "Обменивать автоматически, пока открыта форма";
	Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Флажок.УстановитьДействие("ПриИзменении", "АвтообменПриИзменении");
	Поле = ДобавитьПоле("Интервал", "раз в, мин", Кнопки);
	Поле.Ширина = 4;

	Поле = Элементы.Добавить("Журнал", Тип("ПолеФормы"), Обмен);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Журнал";
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Поле.МногострочныйРежим = Истина;
	Поле.ТолькоПросмотр = Истина;
	Поле.РастягиватьПоГоризонтали = Истина;
	Поле.РастягиватьПоВертикали = Истина;
	Поле.ПодсказкаВвода = "Здесь появится, что приехало с сайта и что ушло на сайт.";

	// «Настройки» — один раз при подключении.
	Настройки = Элементы.Добавить("СтраницаНастройки", Тип("ГруппаФормы"), Страницы);
	Настройки.Вид = ВидГруппыФормы.Страница;
	Настройки.Заголовок = "Настройки";

	ДобавитьПоле("АдресСервера", "Адрес сайта", Настройки);
	Поле = ДобавитьПоле("Ключ", "Ключ обмена (ONEC_API_KEY на сайте)", Настройки);
	Поле.РежимПароля = Истина;
	ДобавитьПоле("ВидРемонта", "Вид ремонта (платный)", Настройки);
	ДобавитьПоле("Цех", "Цех по умолчанию", Настройки);
	ДобавитьПоле("Пост", "Пост по умолчанию (для планировщика)", Настройки);

	Таблица = Элементы.Добавить("Точки", Тип("ТаблицаФормы"), Настройки);
	Таблица.ПутьКДанным = "Точки";
	Таблица.Заголовок = "Точки сайта";
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.ИзменятьПорядокСтрок = Ложь;
	Таблица.Высота = 5;
	Колонка = ДобавитьКолонку("ТочкиНазвание", "Точки.Название", "Точка на сайте", Таблица);
	Колонка.ТолькоПросмотр = Истина;
	ДобавитьКолонку("ТочкиЦех", "Точки.Цех", "Цех", Таблица);
	ДобавитьКолонку("ТочкиПост", "Точки.Пост", "Пост", Таблица);

	Кнопки = Элементы.Добавить("КнопкиНастроек", Тип("ГруппаФормы"), Настройки);
	Кнопки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Кнопки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Кнопки.ОтображатьЗаголовок = Ложь;
	ДобавитьКнопку("СохранитьНастройки", "Сохранить", Кнопки);
	ДобавитьКнопку("ПроверитьСвязь", "Проверить связь", Кнопки);

КонецПроцедуры

&НаСервере
Функция ДобавитьПоле(Имя, Подпись, Родитель)

	ЭлементПоля = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	ЭлементПоля.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементПоля.ПутьКДанным = Имя;
	ЭлементПоля.Заголовок = Подпись;
	Возврат ЭлементПоля;

КонецФункции

&НаСервере
Функция ДобавитьКолонку(Имя, Путь, Подпись, Таблица)

	Колонка = Элементы.Добавить(Имя, Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = Путь;
	Колонка.Заголовок = Подпись;
	Возврат Колонка;

КонецФункции

&НаСервере
Функция ДобавитьКнопку(Имя, Подпись, Родитель)

	Команда = Команды.Добавить(Имя);
	Команда.Действие = Имя;
	Команда.Заголовок = Подпись;
	Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Имя;
	Возврат Кнопка;

КонецФункции

#КонецОбласти
