// Внешняя обработка «Мой Сервис: обмен записями» — модуль объекта.
//
// Записи с сайта становятся заявками на ремонт «1С:Автосервиса», а то, что
// с заявкой сделали в 1С, уезжает обратно на сайт:
//
//   сайт → 1С: новая запись, перенос, смена услуги или машины, отмена —
//              заявка создаётся или переписывается;
//   1С → сайт: перенос или пометка удаления заявки, проведённый
//              заказ-наряд («в работе»), заказ-наряд «Выполнен»/«Закрыт» или
//              пробитый по нему чек («выполнена», итог — сумма заказ-наряда).
//
// Заказ-наряд создаётся по заявке штатно — «Создать на основании», а чек
// пробивается в самом заказ-наряде кнопкой «Пробить чек» на подключённой ККТ.
// Обработка ничего из этого не повторяет: она только связывает документы с
// записью на сайте.
//
// Связь записи и заявки — без лишних реквизитов: ссылка заявки создаётся
// с тем же уникальным идентификатором, что у записи на сайте. Повторная
// выгрузка находит ту же заявку, а не создаёт вторую.
//
// Обмен начинает 1С: из формы (кнопка и автообмен раз в минуту) или
// регламентным заданием, если обработка подключена в «Дополнительных
// отчётах и обработках».

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Регистрация в «Дополнительных отчётах и обработках» (БСП): команда формы
// и серверная команда — её ставят в расписание в карточке обработки.
Функция СведенияОВнешнейОбработке() Экспорт

	Сведения = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	Сведения.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	Сведения.Версия = "1.0";
	Сведения.Наименование = "Мой Сервис: обмен записями";
	Сведения.Информация = "Записи с сайта — в заявки на ремонт, заказ-наряды и чеки — обратно на сайт.";
	// HTTP-запросы в безопасном режиме запрещены.
	Сведения.БезопасныйРежим = Ложь;

	Команда = Сведения.Команды.Добавить();
	Команда.Представление = "Обмен записями с сайтом";
	Команда.Идентификатор = "Открыть";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Команда = Сведения.Команды.Добавить();
	Команда.Представление = "Обмен записями с сайтом (по расписанию)";
	Команда.Идентификатор = "Обмен";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Возврат Сведения;

КонецФункции

// Серверная команда БСП — её вызывает регламентное задание.
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды = Неопределено) Экспорт

	Если ИдентификаторКоманды <> "Обмен" Тогда
		Возврат;
	КонецЕсли;

	Итог = ВыполнитьОбмен(ЗагрузитьНастройки());
	Уровень = ?(Итог.Ошибки.Количество() = 0, УровеньЖурналаРегистрации.Информация,
		УровеньЖурналаРегистрации.Предупреждение);
	ЗаписьЖурналаРегистрации("МойСервис.Обмен", Уровень, , , ТекстИтога(Итог));

КонецПроцедуры

// Один цикл обмена: выгрузить записи с сайта, затем отправить правки из 1С.
// Порядок важен: сначала 1С узнаёт свежее с сайта и только потом говорит,
// что поменялось у неё, — иначе старая заявка откатила бы перенос на сайте.
//
// Возвращаемое значение:
//   Структура - Выгружено, Применено (Число), Ошибки, Журнал (Массив строк),
//               Точки (Соответствие: id точки сайта → название).
Функция ВыполнитьОбмен(Настройки) Экспорт

	Итог = Новый Структура("Выгружено,Применено,Ошибки,Журнал,Точки",
		0, 0, Новый Массив, Новый Массив, Новый Соответствие);

	Если ПустаяСтрока(Настройки.Ключ) Тогда
		Итог.Ошибки.Добавить("Не задан ключ обмена — вкладка «Настройки».");
		Возврат Итог;
	КонецЕсли;

	ВыгрузитьЗаписи(Настройки, Итог);
	ОтправитьИзменения(Настройки, Итог);
	Возврат Итог;

КонецФункции

Функция ПроверитьСвязь(Настройки) Экспорт

	Ответ = Вызвать(Настройки, "/api/v1/onec/ping/", Неопределено);
	Если Ответ.Код = 200 Тогда
		Возврат "Связь есть. На сайте 1С работает от имени «" + ПолеJSON(Ответ.Данные, "user") + "».";
	КонецЕсли;
	Возврат "Нет связи: " + ТекстОшибки(Ответ);

КонецФункции

Функция ТекстИтога(Итог) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("%1 · с сайта в 1С: %2, из 1С на сайт: %3",
		Формат(ТекущаяДатаСеанса(), "ДЛФ=T"), Итог.Выгружено, Итог.Применено));
	Для Каждого Строка Из Итог.Журнал Цикл
		Строки.Добавить("  " + Строка);
	КонецЦикла;
	Для Каждого Строка Из Итог.Ошибки Цикл
		Строки.Добавить("  ! " + Строка);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Настройки

// Настройки лежат в общем хранилище текущего пользователя. Регламентное
// задание читает настройки того пользователя, от имени которого запущено,
// — в карточке обработки укажите того же, кто заполнял настройки.
Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("АдресСервера", "https://moi-servis.ru");
	Настройки.Вставить("Ключ", "");
	Настройки.Вставить("Цех", Справочники.СтруктурныеЕдиницы.ПустаяСсылка());
	Настройки.Вставить("Пост", Справочники.КлючевыеРесурсы.ПустаяСсылка());
	Настройки.Вставить("ВидРемонта", Справочники.асВидыРемонта.ПустаяСсылка());
	Настройки.Вставить("Автообмен", Ложь);
	Настройки.Вставить("Интервал", 1);
	// Массив структур Ид, Название, Цех, Пост — свой цех и пост у точки сайта.
	Настройки.Вставить("Точки", Новый Массив);
	Возврат Настройки;

КонецФункции

Функция ЗагрузитьНастройки() Экспорт

	Настройки = НастройкиПоУмолчанию();
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("МойСервисОбмен", "Настройки");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Сохраненные);
	КонецЕсли;
	Возврат Настройки;

КонецФункции

Процедура СохранитьНастройки(Настройки) Экспорт

	ХранилищеОбщихНастроек.Сохранить("МойСервисОбмен", "Настройки", Настройки);

КонецПроцедуры

#КонецОбласти

#Область СайтВ1С

Процедура ВыгрузитьЗаписи(Настройки, Итог)

	// Предел пачек — от зацикливания: сайт отдаёт по 50 записей, за один
	// обмен уедет до тысячи, остальное — в следующем.
	Для Пачка = 1 По 20 Цикл

		Ответ = Вызвать(Настройки, "/api/v1/onec/bookings/pending/", Неопределено);
		Если Ответ.Код <> 200 Тогда
			Итог.Ошибки.Добавить("Записи с сайта: " + ТекстОшибки(Ответ));
			Возврат;
		КонецЕсли;

		Подтверждения = Новый Массив;
		Для Каждого Запись Из СписокJSON(Ответ.Данные, "bookings") Цикл

			Результат = ЗаписатьЗаявку(Запись, Настройки);
			Точка = ОбъектJSON(Запись, "point");
			Итог.Точки.Вставить(ПолеJSON(Точка, "id"), ПолеJSON(Точка, "name"));

			Подтверждение = Новый Структура;
			Подтверждение.Вставить("id", ПолеJSON(Запись, "id"));
			Подтверждение.Вставить("version", ПолеJSON(Запись, "version"));
			Подтверждение.Вставить("request_number", Результат.Номер);
			Подтверждение.Вставить("request_version", Результат.Версия);
			Подтверждение.Вставить("error", Результат.Ошибка);
			Подтверждения.Добавить(Подтверждение);

			Название = СтрШаблон("Запись %1 (%2, %3)", ПолеJSON(Запись, "code"),
				ПолеJSON(Запись, "client", "name"), ПолеJSON(Запись, "status_title"));
			Если Не ПустаяСтрока(Результат.Ошибка) Тогда
				Итог.Ошибки.Добавить(Название + ": " + Результат.Ошибка);
			Иначе
				Итог.Выгружено = Итог.Выгружено + 1;
				Итог.Журнал.Добавить(Название + " → заявка " + Результат.Номер
					+ ?(ПустаяСтрока(Результат.Заметка), "", " · " + Результат.Заметка));
			КонецЕсли;

		КонецЦикла;

		Если Подтверждения.Количество() > 0 Тогда
			// Не дошло подтверждение — не страшно: в следующем обмене сайт
			// отдаст те же записи, и они перезапишут те же заявки.
			Подтверждено = Вызвать(Настройки, "/api/v1/onec/bookings/ack/",
				Новый Структура("items", Подтверждения));
			Если Подтверждено.Код <> 200 Тогда
				Итог.Ошибки.Добавить("Подтверждение выгрузки: " + ТекстОшибки(Подтверждено));
				Возврат;
			КонецЕсли;
		КонецЕсли;

		Если ОбъектJSON(Ответ.Данные, "more") <> Истина Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Заявка по записи сайта: создать или переписать то, что знает сайт.
//
// Возвращаемое значение:
//   Структура - Номер, Версия (ВерсияДанных после записи), Ошибка, Заметка.
Функция ЗаписатьЗаявку(Запись, Настройки)

	Итог = Новый Структура("Номер,Версия,Ошибка,Заметка", "", "", "", "");

	// Без общей транзакции: если заявка не проведётся, её надо записать
	// без проведения, а после ошибки внутри транзакции 1С не даст ничего
	// записать. Клиент и машина, созданные до ошибки, не пропадут — их
	// найдут по телефону и госномеру в следующий раз.
	Попытка
		Ссылка = Документы.асЗаявкаНаРемонт.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ПолеJSON(Запись, "id")));
		Объект = Ссылка.ПолучитьОбъект();
		Новая = (Объект = Неопределено);
		Если Новая Тогда
			Объект = Документы.асЗаявкаНаРемонт.СоздатьДокумент();
			Объект.УстановитьСсылкуНового(Ссылка);
			Объект.Дата = ТекущаяДатаСеанса();
			// Пустая структура — заполнение по умолчанию: организация, валюта,
			// виды цен, мастер и цех из настроек пользователя.
			Объект.Заполнить(Новый Структура);
		КонецЕсли;

		Изменено = ЗаполнитьЗаявку(Объект, Запись, Настройки, Новая);
		Если Изменено Или Новая Тогда
			Итог.Заметка = ЗаписатьЗаявкуВБазу(Объект, ПолеJSON(Запись, "status"));
		Иначе
			Итог.Заметка = "без изменений";
		КонецЕсли;

		Итог.Номер = Объект.Номер;
		Итог.Версия = Строка(Объект.ВерсияДанных);
	Исключение
		Итог.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Вернуть Истина, если в заявке что-то поменялось. Сравниваем сами: запись
// без изменений поменяла бы ВерсияДанных, и сайт принял бы её за правку.
Функция ЗаполнитьЗаявку(Объект, Запись, Настройки, Новая)

	Изменено = Ложь;
	Клиент = ОбъектJSON(Запись, "client");
	Машина = ОбъектJSON(Запись, "car");
	Точка = ОбъектJSON(Запись, "point");

	Контрагент = НайтиИлиСоздатьКонтрагента(ПолеJSON(Клиент, "name"), ПолеJSON(Клиент, "phone"));
	Установить(Объект, "Контрагент", Контрагент, Изменено);
	Установить(Объект, "Заказчик", Контрагент, Изменено);
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		Установить(Объект, "Договор",
			Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент), Изменено);
	КонецЕсли;

	Автомобиль = НайтиИлиСоздатьАвтомобиль(Машина, Контрагент);
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		Установить(Объект, "Автомобиль", Автомобиль, Изменено);
	КонецЕсли;

	// ПередЗаписью заявки очищает контрагента и договор, если вид ремонта не
	// «Платный», — без платного вида клиент из заявки пропал бы.
	Если Не ЗначениеЗаполнено(Объект.ВидРемонта)
		Или Объект.ВидРемонта.ТипРемонта <> Перечисления.асТипыРемонта.Платный Тогда
		Установить(Объект, "ВидРемонта", ПлатныйВидРемонта(Настройки), Изменено);
	КонецЕсли;

	ЦехИПост = ЦехИПостТочки(Настройки, ПолеJSON(Точка, "id"));
	Если ЗначениеЗаполнено(ЦехИПост.Цех) И (Новая Или Не ЗначениеЗаполнено(Объект.СтруктурнаяЕдиница)) Тогда
		Установить(Объект, "СтруктурнаяЕдиница", ЦехИПост.Цех, Изменено);
	КонецЕсли;

	Начало = ДатаИзСтроки(ПолеJSON(Запись, "start"));
	Окончание = ДатаИзСтроки(ПолеJSON(Запись, "end"));
	Установить(Объект, "ДатаНачала", Начало, Изменено);
	Установить(Объект, "ДатаОкончания", Окончание, Изменено);

	Установить(Объект, "КонтактнаяИнформация",
		Непустые(ПолеJSON(Клиент, "name"), ПолеJSON(Клиент, "phone")), Изменено);
	Установить(Объект, "ПричинаОбращения", ПричинаОбращения(Запись), Изменено);
	Установить(Объект, "Комментарий", Комментарий(Запись), Изменено);

	Статус = ПолеJSON(Запись, "status");
	Закрыта = (Статус <> "pending" И Статус <> "in_progress");
	Установить(Объект, "Закрыт", Закрыта, Изменено);

	// Работы и товары — только в пустую заявку: что оператор добавил сам,
	// сайт не затирает. Что выбрано на сайте, видно в «Причине обращения».
	Если Объект.Работы.Количество() = 0 И Объект.Запасы.Количество() = 0 Тогда
		Если ЗаполнитьПозиции(Объект, СписокJSON(Запись, "services")) Тогда
			Изменено = Истина;
		КонецЕсли;
	КонецЕсли;

	Если ЗаполнитьРесурс(Объект, ЦехИПост.Пост, Начало, Окончание) Тогда
		Изменено = Истина;
	КонецЕсли;

	Возврат Изменено;

КонецФункции

// Провести живую, записать без проведения закрытую. Не провелась —
// записать без проведения и сказать почему: заявка всё равно нужна.
Функция ЗаписатьЗаявкуВБазу(Объект, Статус)

	Если Статус = "pending" Или Статус = "in_progress" Тогда
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			Возврат "";
		Исключение
			Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Объект.Записать(РежимЗаписиДокумента.Запись);
		Возврат "записана без проведения: " + Причина;
	КонецЕсли;

	// Отменённая и неявка освобождают пост в планировщике.
	Если Объект.Проведен И Статус <> "completed" Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	Возврат "закрыта";

КонецФункции

Процедура Установить(Объект, Имя, Значение, Изменено)

	Если Объект[Имя] <> Значение Тогда
		Объект[Имя] = Значение;
		Изменено = Истина;
	КонецЕсли;

КонецПроцедуры

Функция ПричинаОбращения(Запись)

	Части = Новый Массив;
	Категория = ПолеJSON(Запись, "category");
	Если Не ПустаяСтрока(Категория) Тогда
		Части.Добавить(Категория);
	КонецЕсли;
	Если ОбъектJSON(Запись, "on_site") = Истина Тогда
		Части.Добавить("услугу подобрать на месте — клиенту нужно перезвонить");
	ИначеЕсли Не ПустаяСтрока(ПолеJSON(Запись, "service_title")) Тогда
		Части.Добавить(ПолеJSON(Запись, "service_title"));
	КонецЕсли;
	Возврат СтрСоединить(Части, ": ");

КонецФункции

Функция Комментарий(Запись)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Запись с сайта, код %1 · %2 · %3", ПолеJSON(Запись, "code"),
		ПолеJSON(Запись, "status_title"), ПолеJSON(Запись, "point", "name")));
	Если Не ПустаяСтрока(ПолеJSON(Запись, "comment")) Тогда
		Строки.Добавить("Клиент: " + ПолеJSON(Запись, "comment"));
	КонецЕсли;
	Если Не ПустаяСтрока(ПолеJSON(Запись, "cancel_reason")) Тогда
		Строки.Добавить("Причина отмены: " + ПолеJSON(Запись, "cancel_reason"));
	КонецЕсли;
	Если Число_(ПолеJSON(Запись, "points_spent")) > 0 Тогда
		Строки.Добавить("Оплачено баллами на сайте: " + ПолеJSON(Запись, "points_spent"));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Позиции записи — работами или товарами заявки. Номенклатура ищется по
// наименованию, точно как услуга названа на сайте; не нашлась — строки
// нет, услуга остаётся в «Причине обращения». НДС не заполняем: ставку
// выберет 1С при пересчёте в заказ-наряде, угадывать её здесь опасно.
Функция ЗаполнитьПозиции(Объект, Услуги)

	Добавлено = Ложь;
	Для Каждого Услуга Из Услуги Цикл

		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(ПолеJSON(Услуга, "title"), Истина);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Количество = Макс(Число_(ПолеJSON(Услуга, "quantity")), 1);
		Цена = Число_(ПолеJSON(Услуга, "price"));

		Если Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас Тогда
			Строка = Объект.Запасы.Добавить();
			Строка.Номенклатура = Номенклатура;
			Строка.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
		Иначе
			Строка = Объект.Работы.Добавить();
			Строка.ИдентификаторРаботы = Новый УникальныйИдентификатор;
			Строка.Номенклатура = Номенклатура;
			Строка.Нормочас = Справочники.асНормочасы.Рубль;
			Строка.Коэффициент = 1;
		КонецЕсли;
		Строка.Количество = Количество;
		Строка.Цена = Цена;
		Строка.Сумма = Цена * Количество;
		Строка.Всего = Строка.Сумма;
		Добавлено = Истина;

	КонецЦикла;
	Возврат Добавлено;

КонецФункции

// Пост в «Ресурсах предприятия» — тогда заявка видна в планировщике.
Функция ЗаполнитьРесурс(Объект, Пост, Начало, Окончание)

	Если Объект.РесурсыПредприятия.Количество() = 0 Тогда
		Если Не ЗначениеЗаполнено(Пост) Тогда
			Возврат Ложь;
		КонецЕсли;
		Строка = Объект.РесурсыПредприятия.Добавить();
		Строка.РесурсПредприятия = Пост;
		Строка.Мощность = 1;
	Иначе
		Строка = Объект.РесурсыПредприятия[0];
		Если Строка.Старт = Начало И Строка.Финиш = Окончание Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Строка.Старт = Начало;
	Строка.Финиш = Окончание;
	Строка.Длительность = Дата(1, 1, 1) + (Окончание - Начало);
	Возврат Истина;

КонецФункции

Функция ЦехИПостТочки(Настройки, ИдТочки)

	Итог = Новый Структура("Цех,Пост", Настройки.Цех, Настройки.Пост);
	Для Каждого Точка Из Настройки.Точки Цикл
		Если Точка.Ид = ИдТочки Тогда
			Если ЗначениеЗаполнено(Точка.Цех) Тогда
				Итог.Цех = Точка.Цех;
			КонецЕсли;
			Если ЗначениеЗаполнено(Точка.Пост) Тогда
				Итог.Пост = Точка.Пост;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ПлатныйВидРемонта(Настройки)

	Если ЗначениеЗаполнено(Настройки.ВидРемонта) Тогда
		Возврат Настройки.ВидРемонта;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.асВидыРемонта КАК Виды
	|ГДЕ
	|	Виды.ТипРемонта = ЗНАЧЕНИЕ(Перечисление.асТипыРемонта.Платный)
	|	И НЕ Виды.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Виды.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "Нет платного вида ремонта — выберите его во вкладке «Настройки».";

КонецФункции

// Клиент по телефону — тем же поиском, что у телефонии 1С. Нет — новый
// контрагент-физлицо с телефоном.
Функция НайтиИлиСоздатьКонтрагента(Имя, Телефон)

	Цифры = СтрЗаменить(Телефон, "+", "");
	Если Не ПустаяСтрока(Цифры) Тогда
		Найден = ТелефонияСервер.ПолучитьАбонентаПоНомеруТелефона(Цифры, Истина, Ложь, Ложь);
		Если ТипЗнч(Найден) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Найден) Тогда
			Возврат Найден;
		КонецЕсли;
	КонецЕсли;

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Данные = Новый Структура;
	Данные.Вставить("Наименование", ?(ПустаяСтрока(Имя), Телефон, Имя));
	Данные.Вставить("НаименованиеПолное", Данные.Наименование);
	Данные.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ФизическоеЛицо);
	Данные.Вставить("Покупатель", Истина);
	Если Не ПустаяСтрока(Телефон) Тогда
		Данные.Вставить("НомерТелефона", Телефон);
	КонецЕсли;
	Контрагент.Заполнить(Данные);
	Контрагент.Комментарий = "Создан обменом с сайтом";
	Контрагент.Записать();
	Возврат Контрагент.Ссылка;

КонецФункции

// Машина по госномеру из регистра «Автомобили» (там же, где её ищет сама
// 1С). Нет — новая, с госномером и хозяином. Без номера и названия —
// пусто: оператор выберет машину сам.
Функция НайтиИлиСоздатьАвтомобиль(Машина, Контрагент)

	Номер = ПолеJSON(Машина, "plate");
	Название = ПолеJSON(Машина, "title");

	Если Не ПустаяСтрока(Номер) Тогда
		// Сначала грубо — по цифрам номера в запросе, потом точно — по
		// приведённому номеру: в базе он может быть записан как угодно.
		Цифры = "";
		Для Позиция = 1 По СтрДлина(Номер) Цикл
			Символ = Сред(Номер, Позиция, 1);
			Если СтрНайти("0123456789", Символ) > 0 Тогда
				Цифры = Цифры + Символ;
			КонецЕсли;
		КонецЦикла;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сведения.Автомобиль КАК Автомобиль,
		|	ВЫРАЗИТЬ(Сведения.Значение КАК СТРОКА(30)) КАК Номер
		|ИЗ
		|	РегистрСведений.асАвтомобили.СрезПоследних(, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.асДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК Сведения
		|ГДЕ
		|	ВЫРАЗИТЬ(Сведения.Значение КАК СТРОКА(30)) ПОДОБНО &Шаблон
		|	И НЕ Сведения.Автомобиль.ПометкаУдаления");
		Запрос.УстановитьПараметр("Шаблон", "%" + Лев(Цифры, 3) + "%");
		Искомый = НомерДляПоиска(Номер);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НомерДляПоиска(Выборка.Номер) = Искомый Тогда
				Возврат Выборка.Автомобиль;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ПустаяСтрока(Номер) И ПустаяСтрока(Название) Тогда
		Возврат Справочники.асАвтомобили.ПустаяСсылка();
	КонецЕсли;

	Автомобиль = Справочники.асАвтомобили.СоздатьЭлемент();
	Автомобиль.Наименование = Лев(Непустые(Название, Номер), 100);
	Автомобиль.VIN = ПолеJSON(Машина, "vin");
	Год = Число_(ПолеJSON(Машина, "year"));
	Если Год > 1900 Тогда
		Автомобиль.ГодВыпуска = Дата(Год, 1, 1);
	КонецЕсли;
	Автомобиль.Комментарий = "Создан обменом с сайтом";
	Автомобиль.Записать();

	Виды = Перечисления.асДополнительнаяИнформацияАвтомобилей;
	Если Не ПустаяСтрока(Номер) Тогда
		Справочники.асАвтомобили.ЗаписатьЗначенияДополнительнойИнформацииАвтомобиля(
			Автомобиль.Ссылка, Номер, Виды.ГосНомер);
	КонецЕсли;
	Справочники.асАвтомобили.ЗаписатьЗначенияДополнительнойИнформацииАвтомобиля(
		Автомобиль.Ссылка, Контрагент, Виды.Хозяин);
	Пробег = Число_(ПолеJSON(Машина, "mileage"));
	Если Пробег > 0 Тогда
		Справочники.асАвтомобили.ЗаписатьЗначенияДополнительнойИнформацииАвтомобиля(
			Автомобиль.Ссылка, Пробег, Виды.Пробег);
	КонецЕсли;
	Возврат Автомобиль.Ссылка;

КонецФункции

#КонецОбласти

#Область ИзОдинСНаСайт

Процедура ОтправитьИзменения(Настройки, Итог)

	Ответ = Вызвать(Настройки, "/api/v1/onec/bookings/linked/", Неопределено);
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибки.Добавить("Список записей с сайта: " + ТекстОшибки(Ответ));
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Ид Из СписокJSON(Ответ.Данные, "ids") Цикл
		Ссылки.Добавить(Документы.асЗаявкаНаРемонт.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид)));
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Элементы = СостояниеЗаявок(Ссылки);
	// Пачками: сайт принимает до 500 за раз, а длинный запрос дольше висит.
	Пачка = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Пачка.Добавить(Элемент);
		Если Пачка.Количество() = 100 Тогда
			ОтправитьПачку(Настройки, Пачка, Итог);
			Пачка = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пачка.Количество() > 0 Тогда
		ОтправитьПачку(Настройки, Пачка, Итог);
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьПачку(Настройки, Пачка, Итог)

	Номера = Новый Соответствие;
	Для Каждого Элемент Из Пачка Цикл
		Номера.Вставить(Элемент.id, Элемент.request.number);
	КонецЦикла;

	Ответ = Вызвать(Настройки, "/api/v1/onec/bookings/changes/", Новый Структура("items", Пачка));
	Если Ответ.Код <> 200 Тогда
		Итог.Ошибки.Добавить("Правки на сайт: " + ТекстОшибки(Ответ));
		Возврат;
	КонецЕсли;

	Действия = Новый Соответствие;
	Действия.Вставить("cancelled", "отменена на сайте");
	Действия.Вставить("rescheduled", "перенесена на сайте");
	Действия.Вставить("started", "на сайте «в работе»");
	Действия.Вставить("completed", "на сайте «выполнена»");

	Для Каждого Результат Из СписокJSON(Ответ.Данные, "results") Цикл
		Заявка = "Заявка " + Номера.Получить(ПолеJSON(Результат, "id"));
		Если ОбъектJSON(Результат, "ok") <> Истина Тогда
			Итог.Ошибки.Добавить(Заявка + ": сайт не принял правку — "
				+ ПолеJSON(Результат, "error", "message") + ". Заявка вернётся к записи на сайте.");
			Продолжить;
		КонецЕсли;
		Для Каждого Действие Из СписокJSON(Результат, "applied") Цикл
			Итог.Применено = Итог.Применено + 1;
			Итог.Журнал.Добавить(Заявка + " → " + Действия.Получить(Действие));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Заявки и их заказ-наряды одним запросом — в том виде, что ждёт сайт.
Функция СостояниеЗаявок(Ссылки)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заявки.Ссылка КАК Ссылка,
	|	Заявки.Номер КАК Номер,
	|	Заявки.ВерсияДанных КАК Версия,
	|	Заявки.ДатаНачала КАК ДатаНачала,
	|	Заявки.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.асЗаявкаНаРемонт КАК Заявки
	|ГДЕ
	|	Заявки.Ссылка В (&Ссылки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Наряды.Ссылка КАК Ссылка,
	|	Наряды.ДокументОснование КАК Заявка,
	|	Наряды.Номер КАК Номер,
	|	Наряды.ВерсияДанных КАК Версия,
	|	ВЫБОР
	|		КОГДА Наряды.Закрыт
	|				ИЛИ Наряды.Состояние = ЗНАЧЕНИЕ(Справочник.асСостоянияЗаказНарядов.Закрыт)
	|			ТОГДА ""Закрыт""
	|		КОГДА Наряды.Состояние = ЗНАЧЕНИЕ(Справочник.асСостоянияЗаказНарядов.Выполнен)
	|			ТОГДА ""Выполнен""
	|		ИНАЧЕ ЕСТЬNULL(Наряды.Состояние.Наименование, """")
	|	КОНЕЦ КАК Состояние,
	|	Наряды.Проведен КАК Проведен,
	|	Наряды.ПометкаУдаления КАК ПометкаУдаления,
	|	Наряды.СуммаДокумента КАК Сумма,
	|	Наряды.НомерЧекаККМ КАК НомерЧека
	|ИЗ
	|	Документ.асЗаказНаряд КАК Наряды
	|ГДЕ
	|	Наряды.ДокументОснование В (&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наряды.ПометкаУдаления,
	|	Наряды.Проведен УБЫВ,
	|	Наряды.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Работы.Ссылка КАК Наряд,
	|	Работы.Номенклатура.Наименование КАК Имя,
	|	Работы.Всего КАК Всего
	|ИЗ
	|	Документ.асЗаказНаряд.Работы КАК Работы
	|ГДЕ
	|	Работы.Ссылка.ДокументОснование В (&Ссылки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Запасы.Ссылка,
	|	Запасы.Номенклатура.Наименование,
	|	Запасы.Всего
	|ИЗ
	|	Документ.асЗаказНаряд.Запасы КАК Запасы
	|ГДЕ
	|	Запасы.Ссылка.ДокументОснование В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Результаты = Запрос.ВыполнитьПакет();

	Строки = Новый Соответствие;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Список = Строки.Получить(Выборка.Наряд);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Строки.Вставить(Выборка.Наряд, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("name,total", Строка(Выборка.Имя), Выборка.Всего));
	КонецЦикла;

	// У заявки может быть несколько заказ-нарядов — берём живой и свежий:
	// запрос уже упорядочил их так, первый и есть нужный.
	Наряды = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Наряды.Получить(Выборка.Заявка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Наряд = Новый Структура;
		Наряд.Вставить("ref", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Наряд.Вставить("number", Выборка.Номер);
		Наряд.Вставить("version", Строка(Выборка.Версия));
		Наряд.Вставить("state", Выборка.Состояние);
		Наряд.Вставить("posted", Выборка.Проведен);
		Наряд.Вставить("deleted", Выборка.ПометкаУдаления);
		Наряд.Вставить("total", Выборка.Сумма);
		Если Выборка.НомерЧека > 0 Тогда
			// Чек пробит в заказ-наряде — оплачен весь заказ-наряд.
			Наряд.Вставить("receipt_number", Формат(Выборка.НомерЧека, "ЧГ=0"));
			Наряд.Вставить("paid_total", Выборка.Сумма);
			Наряд.Вставить("paid_at", СтрокаДаты(ТекущаяДатаСеанса()));
		КонецЕсли;
		Список = Строки.Получить(Выборка.Ссылка);
		Наряд.Вставить("lines", ?(Список = Неопределено, Новый Массив, Список));
		Наряды.Вставить(Выборка.Заявка, Наряд);
	КонецЦикла;

	Элементы = Новый Массив;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Заявка = Новый Структура;
		Заявка.Вставить("number", Выборка.Номер);
		Заявка.Вставить("version", Строка(Выборка.Версия));
		Заявка.Вставить("start", СтрокаДаты(Выборка.ДатаНачала));
		Заявка.Вставить("deleted", Выборка.ПометкаУдаления);

		Элемент = Новый Структура("id,request", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Заявка);
		Наряд = Наряды.Получить(Выборка.Ссылка);
		Если Наряд <> Неопределено Тогда
			Элемент.Вставить("order", Наряд);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Элементы;

КонецФункции

#КонецОбласти

#Область HTTP

// Один запрос к сайту: без тела — GET, с телом — POST в JSON. Ключ —
// заголовком: в адресе он попал бы в журналы nginx.
Функция Вызвать(Настройки, Путь, Тело)

	Итог = Новый Структура("Код,Данные,Ошибка", 0, Неопределено, "");
	Части = РазобратьАдрес(Настройки.АдресСервера);
	Если Части = Неопределено Тогда
		Итог.Ошибка = "Адрес сайта — вида https://moi-servis.ru";
		Возврат Итог;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("Authorization", "OneC " + СокрЛП(Настройки.Ключ));

	Попытка
		Защита = ?(Части.Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
		Соединение = Новый HTTPСоединение(Части.Хост, Части.Порт, , , , 60, Защита);
		Запрос = Новый HTTPЗапрос(Части.Префикс + Путь, Заголовки);
		Если Тело = Неопределено Тогда
			Ответ = Соединение.Получить(Запрос);
		Иначе
			Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
			Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		КонецЕсли;
	Исключение
		Итог.Ошибка = "Нет связи с сайтом: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Итог.Код = Ответ.КодСостояния;
	Текст = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Не ПустаяСтрока(Текст) Тогда
		Попытка
			Итог.Данные = ИзJSON(Текст);
		Исключение
			Итог.Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// «https://moi-servis.ru» → хост, порт, https ли, путь-префикс.
Функция РазобратьАдрес(Адрес)

	Остаток = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Остаток), "https://") Тогда
		Защищенное = Истина;
		Остаток = Сред(Остаток, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Остаток), "http://") Тогда
		Защищенное = Ложь;
		Остаток = Сред(Остаток, 8);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Префикс = "";
	Слеш = СтрНайти(Остаток, "/");
	Если Слеш > 0 Тогда
		Префикс = Сред(Остаток, Слеш);
		Остаток = Лев(Остаток, Слеш - 1);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Префикс, "/") Цикл
		Префикс = Лев(Префикс, СтрДлина(Префикс) - 1);
	КонецЦикла;

	Порт = ?(Защищенное, 443, 80);
	Двоеточие = СтрНайти(Остаток, ":");
	Если Двоеточие > 0 Тогда
		Порт = Число(Сред(Остаток, Двоеточие + 1));
		Остаток = Лев(Остаток, Двоеточие - 1);
	КонецЕсли;

	Если ПустаяСтрока(Остаток) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Хост,Порт,Защищенное,Префикс", Остаток, Порт, Защищенное, Префикс);

КонецФункции

Функция ТекстОшибки(Ответ)

	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Ответ.Ошибка;
	КонецЕсли;
	Сообщение = ПолеJSON(Ответ.Данные, "error", "message");
	Если ПустаяСтрока(Сообщение) Тогда
		Сообщение = "Сайт ответил кодом " + Формат(Ответ.Код, "ЧГ=0");
	КонецЕсли;
	Возврат Сообщение;

КонецФункции

#КонецОбласти

#Область JSON

Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ИзJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

// Строка из ответа: Данные[Ключ] или Данные[Ключ][Ключ2]; нет — пустая.
Функция ПолеJSON(Данные, Ключ, Ключ2 = Неопределено)

	Значение = ОбъектJSON(Данные, Ключ);
	Если Ключ2 <> Неопределено Тогда
		Возврат ПолеJSON(Значение, Ключ2);
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ОбъектJSON(Данные, Ключ)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Данные.Получить(Ключ);

КонецФункции

Функция СписокJSON(Данные, Ключ)

	Значение = ОбъектJSON(Данные, Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

КонецФункции

#КонецОбласти

#Область Прочее

// «2026-10-28T10:30:00» — местное время точки, как его отдаёт сайт.
Функция ДатаИзСтроки(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат XMLЗначение(Тип("Дата"), Лев(Текст, 19));

КонецФункции

// Обратно на сайт — в том же виде; пустая дата — пустая строка, а не
// «0001-01-01», которую сайт принял бы за перенос в первый век.
Функция СтрокаДаты(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат XMLСтрока(Значение);

КонецФункции

// Госномер к одной форме, как на сайте: без пробелов, заглавными, латиница,
// похожая на кириллицу, — кириллицей. Оператор 1С пишет «а 123 вс 77» или
// латиницей, сайт — «А123ВС77», а машина одна.
Функция НомерДляПоиска(Номер)

	Итог = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(Номер), " ", ""), "-", ""));
	Латиница = "ABEKMHOPCTYX";
	Кириллица = "АВЕКМНОРСТУХ";
	Для Позиция = 1 По СтрДлина(Латиница) Цикл
		Итог = СтрЗаменить(Итог, Сред(Латиница, Позиция, 1), Сред(Кириллица, Позиция, 1));
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Сайт отдаёт деньги строкой «4800.00»: Число() с точкой не дружит в
// русской локали — разбираем сами.
Функция Число_(Текст)

	Чистый = СтрЗаменить(СокрЛП(Текст), ",", ".");
	Если ПустаяСтрока(Чистый) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Число"), Чистый);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция Непустые(Знач А = "", Знач Б = "")

	Части = Новый Массив;
	Если Не ПустаяСтрока(А) Тогда
		Части.Добавить(А);
	КонецЕсли;
	Если Не ПустаяСтрока(Б) Тогда
		Части.Добавить(Б);
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

