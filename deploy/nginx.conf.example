# Конфиг nginx перед daphne. На сервере кладётся в
# /etc/nginx/sites-available/autoservice и линкуется в sites-enabled.
#
# Здесь только HTTP-версия: сертификаты и редирект на HTTPS дописывает certbot
# командой `certbot --nginx -d <домен> -d <домен> ...`. Писать ssl-секции
# руками не нужно — certbot находит нужные server_name и правит файл сам.
#
# Два блока: основной домен обслуживает сайт, второстепенные редиректят на
# него. Так у страницы один канонический адрес — иначе поисковики видят один и
# тот же контент на пяти адресах и делят между ними вес.
#
# Основной — moiservis.pro. Прежние домены «Экспресс Замена» остались и ведут
# сюда же: у них уже есть история и их успели раздать.
#
# Кириллический домен пишется в punycode (`xn--…`): именно в таком виде он
# приходит в заголовке Host, и certbot работает только с этой формой.

# ------------------------------------------------------------- лог и лимиты
# Браузер не умеет слать заголовки при открытии WebSocket, поэтому access-токен
# едет в адресе: `/ws/booking/?token=<JWT>`. Стандартный combined-формат пишет
# в access.log строку запроса целиком — и токен живёт в файле, пока логи не
# ротируются, доступный всем, кто дотянулся до сервера или до выгрузки логов.
# `$uri` — тот же путь, но без параметров.
log_format ws_no_args '$remote_addr - [$time_local] "$request_method $uri" '
                      '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# Вход в Django-админку — единственная форма на сайте, которую защищает только
# пароль: API-эндпоинты входа лимитирует сам DRF, а здесь перебирать можно
# сколько угодно. За админкой лежат телефоны и госномера всей клиентской базы.
# 10 попыток в минуту с адреса живому человеку хватает с запасом.
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;

# ---------------------------------------------------------------- редирект
server {
    listen 80;
    listen [::]:80;
    server_name www.moiservis.pro
                ekspres-zamena.ru
                www.ekspres-zamena.ru
                xn----8sbarcksuknlkd6n.xn--p1ai
                www.xn----8sbarcksuknlkd6n.xn--p1ai;

    # 301, а не 302: постоянный редирект поисковики учитывают при склейке
    # адресов, временный — нет.
    return 301 https://moiservis.pro$request_uri;
}

# ---------------------------------------------------------------- основной
server {
    listen 80;
    listen [::]:80;
    server_name moiservis.pro;

    # Загрузки пользователей: аватары и вложения крупнее дефолтного 1 МБ.
    client_max_body_size 10m;

    # При DEBUG=False Django статику не отдаёт вовсе. Каталоги те же, что
    # смонтированы в контейнер в docker-compose.prod.yml.
    #
    # Год и immutable — потому что в проде имена файлов содержат хеш
    # содержимого (`landing.a1b2c3d4.css`, см. STORAGES в settings/prod.py).
    # Изменился файл — изменился адрес, старый браузер всё равно пойдёт за
    # новым. Без хеша такой заголовок был бы ловушкой: выкатка нового
    # оформления неделями не доезжала бы до вернувшихся посетителей.
    location /static/ {
        alias /opt/auto_service/static/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /media/ {
        alias /opt/auto_service/media/;
        access_log off;
        expires 7d;
    }

    # Живой статус записи и канал сотрудника. Отдельная секция нужна из-за
    # заголовков Upgrade: без них nginx закрывает соединение как обычный HTTP,
    # и WebSocket не поднимается.
    location /ws/ {
        # Без строки запроса: в ней едет access-токен, см. log_format выше.
        access_log /var/log/nginx/access.log ws_no_args;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Канал молчит, пока ничего не происходит; дефолтные 60 секунд рвали бы
        # его на каждой паузе.
        proxy_read_timeout 3600s;
    }

    # Отдельная секция ровно под форму входа в админку: лимит вешается на
    # неё, а не на весь /admin/, иначе работа администратора со справочниками
    # упёрлась бы в тот же счётчик.
    location = /admin/login/ {
        limit_req zone=admin_login burst=5 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Без этого заголовка prod-настройки Django считают запрос пришедшим по
        # HTTP и редиректят на HTTPS — а nginx снова проксирует его сюда же.
        # Получается петля редиректов.
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
