# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-please-use-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Нужен только за HTTPS: без него вход в админку и панели отдаёт 403.
# Кириллический домен пишется в punycode — в таком виде приходит Host.
CSRF_TRUSTED_ORIGINS=

# Демо-данные (2 точки, масла, учётки мастера и админа с паролями из README).
# На проде обязательно false: иначе в админку пускают известные всем пароли.
BOOTSTRAP_DEMO=true

# ---- PostgreSQL ----
POSTGRES_DB=autoservice
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=autoservice
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# ---- JWT ----
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=30

# ---- Business rules ----
BOOKING_DRAFT_TTL_SECONDS=300
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_HORIZON_DAYS=14
BOOKING_CANCEL_DEADLINE_MINUTES=60
BOOKING_REMINDER_LEAD_MINUTES=120

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_DEBUG_EXPOSE_CODE=True

# ---- SMS ----
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=AutoService

# ---- Лендинг: контакты и приложения ----
COMPANY_NAME=Экспресс Замена
COMPANY_TAGLINE=Замена масла за 30 минут
COMPANY_PHONE=+7 (499) 123-45-67
COMPANY_EMAIL=hello@example.com
COMPANY_WORKING_HOURS=Ежедневно 09:00–21:00
# Пустые ссылки = кнопка «скоро», без перехода
COMPANY_APP_STORE_URL=
COMPANY_GOOGLE_PLAY_URL=
COMPANY_YEARS_ON_MARKET=8
COMPANY_CARS_SERVED=14000
