# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-please-use-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Нужен только за HTTPS: без него вход в админку и панели отдаёт 403.
# Кириллический домен пишется в punycode — в таком виде приходит Host.
CSRF_TRUSTED_ORIGINS=
# На проде, для примера:
#   ALLOWED_HOSTS=moi-servis.ru,www.moi-servis.ru
#   CSRF_TRUSTED_ORIGINS=https://moi-servis.ru,https://www.moi-servis.ru

# Демо-данные (2 точки, масла, учётки мастера и админа с паролями из README).
# На проде обязательно false: иначе в админку пускают известные всем пароли.
BOOTSTRAP_DEMO=true

# Сколько СВОИХ обратных прокси стоит перед приложением. По этому числу
# DRF понимает, какому элементу X-Forwarded-For можно верить: заголовок
# начинает писать сам клиент, и лимиты по IP иначе обходятся подстановкой.
# 0 — приложение смотрит в сеть напрямую (разработка), 1 — за одним nginx.
# В config/settings/prod.py значение по умолчанию уже 1.
NUM_PROXIES=0

# Куда Sentry шлёт ошибки прода. Пусто — никуда, ошибки видны только в логах.
SENTRY_DSN=
# Редирект HTTP -> HTTPS. Выключать только если HTTPS терминирует что-то
# другое и оно же делает редирект. Читается только прод-настройками.
SECURE_SSL_REDIRECT=True

# ---- PostgreSQL ----
POSTGRES_DB=autoservice
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=autoservice
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# ---- JWT ----
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=30

# ---- Business rules ----
BOOKING_DRAFT_TTL_SECONDS=300
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_HORIZON_DAYS=14
BOOKING_CANCEL_DEADLINE_MINUTES=60
BOOKING_REMINDER_LEAD_MINUTES=120
BOOKING_DRAFT_PURGE_AFTER_DAYS=7

# В каком поясе сотрудники думают о «сегодня». Локальное время конкретной
# точки всегда берётся из ServicePoint.timezone, это только для сводок.
BUSINESS_TIMEZONE=Europe/Moscow

# ---- Бэкапы PostgreSQL ----
# Снимает deploy/backup.sh по cron на хосте. Приложению эти значения нужны
# только чтобы `manage.py security_audit` видел, есть ли свежий снимок.
# Каталог — относительно корня проекта.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
BACKUP_MAX_AGE_HOURS=36
# Куда отправить копию за пределы сервера: любая цель rsync,
# например backup@storage.example.com:/srv/autoservice. Пусто — копии нет,
# и снимки лежат на том же диске, что и база: от отказа диска не спасают.
BACKUP_REMOTE=

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=5
# Отдавать код входа прямо в ответе API. Нужно только в разработке, чтобы
# не поднимать SMS-шлюз. В прод-настройках значение принудительно False —
# опечатка здесь дверь не откроет.
OTP_DEBUG_EXPOSE_CODE=True
# ВРЕМЕННАЯ ЗАГЛУШКА на время, пока у SMS-шлюза не согласован буквенный
# отправитель и сообщения не уходят. Перечисленным номерам код входа
# возвращается в ответе API даже в проде — приложение показывает его
# уведомлением. Каждый номер здесь это открытая дверь в его аккаунт:
# запросить код и прочитать ответ может кто угодно. Только свои тестовые
# номера, и убрать сразу после запуска SMS — security_audit считает
# непустой список провалом.
OTP_DEBUG_PHONES=

# ---- Режим входа ----
# smsru       — SMS.RU звонит клиенту, код — последние 4 цифры номера
#               (настройки ниже), запасное SMS — тоже SMS.RU;
# verificahub — клиент сам звонит на показанный номер (обратный flash-call
#               VerificaHub, 0,25 ₽), код вводить не нужно; запасное SMS —
#               тоже VerificaHub. Ключи — в личном кабинете verificahub.ru.
OTP_MODE=smsru
VERIFICAHUB_API_KEY=
VERIFICAHUB_API_SECRET=

# ---- Код входа звонком (OTP_MODE=smsru) ----
# Клиенту звонят, код — последние 4 цифры номера, с которого звонят.
# console — никому не звонит, печатает код в лог (разработка);
# smsru — SMS.RU, ключ тот же SMS_API_KEY, 0,40 ₽ за звонок, буквенный
# отправитель не нужен.
OTP_CALL_PROVIDER=console
# Сколько звонков без входа, прежде чем предложить код в SMS.
OTP_CALLS_BEFORE_SMS=2

# ---- Вход сотрудников по паролю ----
# Неверных паролей подряд на один номер, после чего он закрыт на N минут.
STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_LOCK_MINUTES=15

# ---- SMS ----
# console — печатать в лог (разработка), smsru — боевой шлюз sms.ru
SMS_PROVIDER=console
SMS_API_KEY=
# Буквенный отправитель. ОБЯЗАТЕЛЕН для боевой отправки: без него шлюз
# отвечает кодом 221 и не пропускает ни одного сообщения. Регистрируется
# на https://sms.ru/?panel=senders и проходит модерацию.
SMS_SENDER=
# Какие уведомления реально уходят. Каждое стоит денег: чтобы платить
# только за нужное, оставьте otp,booking_reminder,booking_cancelled_by_master
SMS_ENABLED_KINDS=otp,booking_created,booking_reminder,booking_cancelled_by_master,booking_completed

# ---- Реферальная программа ----
REFERRAL_ENABLED=true
# Проценты по линиям вверх от заплатившего: первая, вторая, третья.
# Длина списка задаёт глубину — четвёртое число включит четвёртую линию.
REFERRAL_LEVEL_PERCENTS=5,4,3
# С какой части чека считаем: total (масло + работа) или work (только работа)
REFERRAL_BASE=total
# Сколько мест под участником. 2 = бинарная матрица
REFERRAL_WIDTH=2
# Потолок оплаты баллами, % от чека
REFERRAL_MAX_DISCOUNT_PERCENT=50
# Сведение плеч и выплата — раз в сутки, в полночь этого пояса (Челябинск).
REFERRAL_PAYOUT_TIMEZONE=Asia/Yekaterinburg

# ---- Гараж ----
# Защитный потолок машин у одного клиента (не правило бизнеса)
GARAGE_MAX_CARS=10
# Замена масла по умолчанию: км или месяцы, что наступит раньше
GARAGE_OIL_INTERVAL_KM=10000
GARAGE_OIL_INTERVAL_MONTHS=12
# Смена резины, ММ-ДД — поправьте под свой регион
GARAGE_SUMMER_TIRES_FROM=04-20
GARAGE_WINTER_TIRES_FROM=10-01
# «Скоро» в напоминаниях: за столько км или дней до срока
GARAGE_SOON_KM=1000
GARAGE_SOON_DAYS=30

# ---- Android App Links ----
# Без /.well-known/assetlinks.json ссылка-приглашение откроется в браузере,
# а не в приложении. Отпечаток подписи берётся так:
#   keytool -list -v -keystore <файл.jks> -alias <alias>
# а для сборок, которые подписывает Google Play, — в консоли,
# «Целостность приложения» → «Подписание приложений».
ANDROID_PACKAGE=ru.autoservice.client
ANDROID_CERT_FINGERPRINTS=

# ---- Лендинг: контакты и приложения ----
# Канонический адрес сайта: из него строятся ссылки-приглашения.
COMPANY_SITE_URL=https://moi-servis.ru
COMPANY_NAME=Мой Сервис
COMPANY_TAGLINE=Замена масла по записи
COMPANY_PHONE=+7 (499) 123-45-67
COMPANY_EMAIL=hello@example.com
COMPANY_WORKING_HOURS=Ежедневно 09:00–21:00
# Пустые ссылки = кнопка «скоро», без перехода
COMPANY_APP_STORE_URL=
COMPANY_GOOGLE_PLAY_URL=
# Цифры в шапке витрины — только реальные. 0 или пусто = не показываем.
# Оценку берите с внешней площадки и указывайте её в RATING_SOURCE
# в предложном падеже: «Яндекс Картах» → «оценка на Яндекс Картах».
COMPANY_YEARS_ON_MARKET=0
COMPANY_CARS_SERVED=0
COMPANY_RATING=
COMPANY_RATING_SOURCE=

# ---- Реквизиты для подвала сайта ----
# Операторы связи проверяют их при регистрации имени отправителя SMS.
COMPANY_LEGAL_NAME=ИП Иванов Иван Иванович
COMPANY_INN=771234567890
COMPANY_OGRN=321774600123456
COMPANY_LEGAL_ADDRESS=
