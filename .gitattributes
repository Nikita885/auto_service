# LF во всём репозитории. Критично для docker/entrypoint.sh: с CRLF
# контейнер падает на shebang («bad interpreter»), а Windows-клон
# по умолчанию подставил бы именно CRLF.
* text=auto eol=lf

*.sh    text eol=lf
Makefile text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.html  text eol=lf

# Сгенерированная схема — не считать её изменения в diff-статистике
openapi.yaml linguist-generated=true

# Gradle wrapper. gradlew запускают из sh — ему нужен LF; gradlew.bat
# выполняет cmd.exe, там ожидается CRLF. Правило `*.sh` ни то, ни другое
# не покрывает: у обоих файлов нет расширения .sh.
gradlew  text eol=lf
gradlew.bat text eol=crlf
*.jar    binary
