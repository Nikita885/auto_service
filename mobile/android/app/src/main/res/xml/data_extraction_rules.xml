<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <!-- Перенос на новое устройство тоже без токенов: вход по SMS занимает
         полминуты, а утёкший refresh живёт 30 дней. -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
