<?xml version="1.0" encoding="utf-8"?>
<!-- Экран входа: тот же почти чёрный фон с синим подтоном и дальним
     синим пятном, что на первом экране витрины. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="720"
                android:centerX="0.8" android:centerY="0.06"
                android:startColor="@color/neon_glow"
                android:endColor="@color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="560"
                android:centerX="0.1" android:centerY="0.9"
                android:startColor="@color/neon_glow_deep"
                android:endColor="@color/transparent" />
        </shape>
    </item>
</layer-list>
