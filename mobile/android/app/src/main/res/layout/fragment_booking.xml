<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран записи. Шаги, таймер и список вариантов — как на лендинге, только
  по вертикали: заголовок шага, индикатор из четырёх точек, что выбрано,
  и список того, что нужно выбрать сейчас.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- шапка: заголовок и действия над черновиком -->
    <TextView
        android:id="@+id/screen_title"
        style="@style/Text.H2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space"
        android:text="@string/booking_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/drop" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/drop"
        style="@style/Widget.AutoService.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_sm"
        android:text="@string/booking_drop"
        android:textColor="@color/danger"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/screen_title"
        app:layout_constraintBottom_toBottomOf="@id/screen_title"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- таймер: пять минут на всю запись -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/timer_card"
        style="@style/Widget.AutoService.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space"
        android:layout_marginEnd="@dimen/space"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/screen_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space">

            <TextView
                android:id="@+id/timer_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="04:38" />

            <ProgressBar
                android:id="@+id/timer_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/space"
                android:layout_marginEnd="@dimen/space"
                android:layout_weight="1"
                android:max="300"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/surface_2"
                tools:progress="180" />

            <TextView
                style="@style/Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/booking_timer_hint" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- индикатор шагов -->
    <LinearLayout
        android:id="@+id/steps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space"
        android:layout_marginEnd="@dimen/space"
        android:layout_marginTop="@dimen/space"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/timer_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <include android:id="@+id/step_1" layout="@layout/view_step" />
        <include android:id="@+id/step_2" layout="@layout/view_step" />
        <include android:id="@+id/step_3" layout="@layout/view_step" />
        <include android:id="@+id/step_4" layout="@layout/view_step" />
    </LinearLayout>

    <TextView
        android:id="@+id/step_title"
        style="@style/Text.H3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space"
        android:layout_marginEnd="@dimen/space"
        android:layout_marginTop="@dimen/space_lg"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/steps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Шаг 2. Выберите масло"
        tools:visibility="visible" />

    <!-- дни: горизонтальная лента, видна только на шаге времени -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/days"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space"
        android:paddingEnd="@dimen/space"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/step_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_day"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space"
        android:paddingEnd="@dimen/space"
        android:paddingBottom="@dimen/space_lg"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/days"
        app:layout_constraintBottom_toTopOf="@id/confirm_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_oil" />

    <!-- пустое состояние: записи ещё нет или она сгорела -->
    <LinearLayout
        android:id="@+id/idle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        app:layout_constraintTop_toBottomOf="@id/screen_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/idle_text"
            style="@style/Text.Soft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/booking_idle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            style="@style/Widget.AutoService.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/booking_start" />
    </LinearLayout>

    <!-- подтверждение: видно только на последнем шаге -->
    <LinearLayout
        android:id="@+id/confirm_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="@dimen/space"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/summary"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            tools:text="Северная · ул. Складочная, 1с18" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoService.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/comment_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/comment_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="500" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm"
            style="@style/Widget.AutoService.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/confirm_action" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
