<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AutoService.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/accent_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:orientation="vertical"
        android:padding="@dimen/space">

        <TextView
            android:id="@+id/name"
            style="@style/Text.H3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Северная" />

        <TextView
            android:id="@+id/address"
            style="@style/Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="г. Москва, ул. Складочная, 1с18" />

        <TextView
            android:id="@+id/hours"
            style="@style/Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/text_faint"
            tools:text="09:00–21:00 · 2 поста" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
