<?xml version="1.0" encoding="utf-8"?>
<!-- Строка подсказки: марка или модель. Вид один — разница только в том,
     ведёт ли нажатие к следующему шагу. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/title"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Mercedes-Benz" />

    <TextView
        android:id="@+id/chevron"
        style="@style/Text.Soft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="›"
        android:textSize="20sp" />
</LinearLayout>
