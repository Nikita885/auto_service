<?xml version="1.0" encoding="utf-8"?>
<!--
  Знакомство сразу после первого входа. Имя и машину всё равно спросят —
  лучше один раз здесь, чем мастер по телефону в день визита.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space">

        <TextView
            style="@style/Text.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/onboarding_title" />

        <TextView
            style="@style/Text.Soft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/onboarding_sub" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoService.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/onboarding_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="150" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space"
            android:text="@string/onboarding_car" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/car"
            style="@style/Widget.AutoService.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/onboarding_car_empty"
            tools:text="Kia Rio" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoService.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/onboarding_plate">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/plate_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="16" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Text.Kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/onboarding_invite" />

        <TextView
            style="@style/Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/onboarding_invite_sub" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AutoService.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/onboarding_invite_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/invite_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="8" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/done"
            style="@style/Widget.AutoService.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/onboarding_done" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip"
            style="@style/Widget.AutoService.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space"
            android:text="@string/onboarding_skip" />
    </LinearLayout>
</ScrollView>
