<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Тема одна и тёмная. На витрине переключателя тоже нет: неон на белом
      фоне перестаёт быть неоном, а фирменный знак — собой. DayNight здесь
      означал бы, что половина клиентов видит другое приложение.
    -->
    <style name="Theme.AutoService" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>

        <!--
          Вторичные и третичные роли Material тоже привязаны к неону.
          Без этого подсветка выбранной вкладки и выбранного сегмента
          берётся из базовой палитры Material и выходит серо-фиолетовой —
          единственное чужое пятно на всём экране.
        -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/accent_soft</item>
        <item name="colorOnTertiaryContainer">@color/accent</item>

        <item name="colorSurface">@color/surface</item>
        <!-- Уровни поверхностей: их берут диалоги, меню и подложки
             Material 3. По умолчанию они высветляются в серый. -->
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="colorErrorContainer">@color/danger_soft</item>
        <item name="colorOnErrorContainer">@color/danger</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_soft</item>
        <item name="colorOutline">@color/border_strong</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="colorError">@color/danger</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="materialButtonStyle">@style/Widget.AutoService.Button</item>
        <item name="textInputStyle">@style/Widget.AutoService.TextInput</item>
    </style>

    <!-- Стартовый экран: без него первый кадр — белая вспышка. -->
    <style name="Theme.AutoService.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AutoService</item>
    </style>

    <!-- ======================================================= компоненты -->

    <style name="Widget.AutoService.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Widget.AutoService.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Widget.AutoService.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Widget.AutoService.Button.Danger" parent="Widget.AutoService.Button.Outlined">
        <item name="android:textColor">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
    </style>

    <style name="Widget.AutoService.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/text_soft</item>
    </style>

    <style name="Widget.AutoService.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ====================================================== типографика -->

    <!-- Точка в имени стиля — это наследование: Text.H1 наследует Text.
         Базовый стиль обязан существовать, иначе AAPT не слинкует ресурсы. -->
    <style name="Text">
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Text.H1">
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Text.H2">
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Text.H3">
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.Soft" parent="Text.Body">
        <item name="android:textColor">@color/text_soft</item>
    </style>

    <style name="Text.Small">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_soft</item>
    </style>

    <!-- Надзаголовок из лендинга: капс, разрядка, акцентный цвет. -->
    <style name="Text.Kicker">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!--
      Полноэкранный диалог. Выбор автомобиля — это список с поиском и
      клавиатурой: в плавающем окне по умолчанию на него остаётся полторы
      видимых строки, а вес у списка схлопывается в ноль.
    -->
    <style name="Theme.AutoService.FullScreenDialog" parent="Theme.AutoService">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
    </style>
</resources>
