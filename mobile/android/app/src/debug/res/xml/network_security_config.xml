<?xml version="1.0" encoding="utf-8"?>
<!--
  Только для отладочной сборки: открытый http разрешён.

  Адрес dev-сервера у каждого свой — эмулятор (10.0.2.2), телефон в локальной
  сети (192.168.x.x), туннель наружу. Перечислить их в конфигурации нельзя:
  подсети здесь не поддерживаются, а держать список чужих IP в репозитории
  незачем.

  Релизная сборка использует другой файл, где cleartext запрещён: подменить
  их местами нельзя, Gradle берёт вариант по типу сборки.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- В debug доверяем и пользовательским сертификатам: без этого
                 не посмотреть трафик через прокси при разборе проблемы. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
